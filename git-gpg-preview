#!/bin/bash

# Git-specific OpenPGP preview wrapper for macOS.
# Only captured real GPG output is allowed to reach stdout.

set -u
umask 077
export LC_ALL=C

PROGRAM_NAME="git-gpg-preview"
# Single source of truth for rejected fixture-style commit subjects
# (lowercase, pipe-separated). Tests read this line; keep the format.
FIXTURE_SUBJECTS="base|fixture|init|initial|initial commit|main|production|seed|work|more|msg|message|x|pr head|mr head"
# Blocked author/committer domains: documentation, testing, and local-use
# names (RFC 2606, 6761, 6762), including subdomains. This fixture heuristic
# also blocks legitimate .local identities. Tests read this line; keep the format.
FIXTURE_EMAIL_DOMAINS="example.com example.net example.org example invalid localhost test local"
CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
CONFIG_FILE="$CONFIG_HOME/git-gpg-preview/config"
SPAM_FILE="$CONFIG_HOME/git-gpg-preview/spam-subjects"
SPAM_TEMP=""
REAL_GPG=""
UI_HELPER=""
LOCK_ROOT=""
AUDIT_LOG=""
REQUEST_DIR=""
LOCK_FILE=""
LOCK_HELD=0
CHILD_PID=""
DIALOG_PID=""
GPG_STDERR=""
PIN_DIALOG_PID=""
UNANSWERABLE_PROMPT=""
SIGNING_KEY=""
SIGNING_KEY_LOOKED_UP=0
TOUCH_POLICY=""
# builtin: the wrapper's own PIN window (GnuPG loopback). pinentry: gpg-agent's.
PIN_PROMPT="builtin"
# Upper bound on PIN attempts per request, even when the card reports more.
PIN_ATTEMPT_LIMIT=10
# With touch policy off or cached, or one that could not be read, the key may
# sign as soon as GPG asks it, so GPG waits for Sign in the preview instead, at
# most SIGN_CLICK_SECONDS. The preview is closed after Sign, so the PIN window
# (or pinentry) and a touch then get SIGN_GPG_SECONDS: time to type a PIN, look
# for the key and touch it. Git waits for the wrapper without a timeout of its
# own, so unlike the remote service, which must answer within its client's
# timeout, these need not share one budget. Tests read these lines; keep the
# format.
SIGN_CLICK_SECONDS=120
SIGN_GPG_SECONDS=90
SIGN_GATE=0
SIGN_NOTICE=""
UNKNOWN_TOUCH_NOTICE="Touch policy unknown: Sign to continue"
# Cached-fixed gets no notice of its own (it cannot be changed), only this
# with the Sign button.
CACHED_FIXED_TOUCH_NOTICE="Touch policy cached-fixed: one touch signs for 15 seconds; Sign is required."
TOUCH_NOTICE=""

error() {
    printf '%s: %s\n' "$PROGRAM_NAME" "$*" >&2
}

cleanup() {
    [[ -z "$SPAM_TEMP" ]] || /bin/rm -f "$SPAM_TEMP"
    flush_gpg_stderr
    if [[ -n "$DIALOG_PID" ]] && /bin/kill -0 "$DIALOG_PID" 2>/dev/null; then
        /bin/kill -s TERM "$DIALOG_PID" 2>/dev/null || true
        wait "$DIALOG_PID" 2>/dev/null || true
        DIALOG_PID=""
    fi
    dismiss_pin_entry
    if [[ "$LOCK_HELD" -eq 1 && -n "$LOCK_FILE" && -f "$LOCK_FILE" ]]; then
        local owner=""
        owner=$(/bin/cat "$LOCK_FILE" 2>/dev/null || true)
        if [[ "$owner" == "$$" ]]; then
            /bin/rm -f "$LOCK_FILE"
        fi
        LOCK_HELD=0
    fi
    if [[ -n "$REQUEST_DIR" && -d "$REQUEST_DIR" ]]; then
        /bin/rm -rf "$REQUEST_DIR"
    fi
}

on_signal() {
    local signal="$1"
    if [[ -n "$CHILD_PID" ]]; then
        /bin/kill -s "$signal" "$CHILD_PID" 2>/dev/null || true
        wait "$CHILD_PID" 2>/dev/null || true
        CHILD_PID=""
    fi
    cleanup
    trap - "$signal"
    /bin/kill -s "$signal" "$$"
}

trap cleanup EXIT
trap 'on_signal HUP' HUP
trap 'on_signal INT' INT
trap 'on_signal QUIT' QUIT
trap 'on_signal TERM' TERM

read_config() {
    if [[ ! -f "$CONFIG_FILE" ]]; then
        error "missing configuration: $CONFIG_FILE"
        return 1
    fi
    while IFS= read -r line || [[ -n "$line" ]]; do
        case "$line" in
            real_gpg=*) REAL_GPG=${line#real_gpg=} ;;
            ui_helper=*) UI_HELPER=${line#ui_helper=} ;;
            lock_root=*) LOCK_ROOT=${line#lock_root=} ;;
            audit_log=*) AUDIT_LOG=${line#audit_log=} ;;
            pin_prompt=*) PIN_PROMPT=${line#pin_prompt=} ;;
            ''|'#'*) ;;
        esac
    done < "$CONFIG_FILE"

    if [[ "$PIN_PROMPT" != builtin && "$PIN_PROMPT" != pinentry ]]; then
        error "pin_prompt must be builtin or pinentry"
        return 1
    fi

    if [[ "$REAL_GPG" != /* || ! -x "$REAL_GPG" ]]; then
        error "real_gpg must name an executable absolute path"
        return 1
    fi
    local self_dir self_path
    self_dir=$(cd -P -- "$(dirname -- "$0")" 2>/dev/null && pwd) || return 1
    self_path="$self_dir/$(basename -- "$0")"
    if [[ "$REAL_GPG" == "$self_path" || "$REAL_GPG" -ef "$self_path" ]]; then
        error "real_gpg resolves to this wrapper; refusing recursion"
        return 1
    fi
    return 0
}

is_signing_request() {
    local arg signing=0 short after_options=0
    for arg in "$@"; do
        if [[ "$after_options" -eq 1 ]]; then
            continue
        fi
        case "$arg" in
            --) after_options=1 ;;
            --*)
                # GnuPG takes any unique prefix of a command's name. --verify
                # does not overrule these: it may be another option's value,
                # and GPG refuses a real signing and verifying command together.
                if [[ "--sign" == "$arg"* || "--detach-sign" == "$arg"* || "--clear-sign" == "$arg"* || "--clearsign" == "$arg"* ]]; then
                    signing=1
                fi
                ;;
            -[!-]*)
                # A value-taking option ends the cluster: the rest is its value.
                short=${arg#-}
                short=${short%%[$GPG_VALUE_SHORT_OPTIONS]*}
                if [[ "$short" == *s* || "$short" == *b* ]]; then
                    signing=1
                fi
                ;;
        esac
    done
    [[ "$signing" -eq 1 ]]
}

# Long options that take their value from the next argument, each one
# required in GnuPG 2.2 and 2.4's g10/gpg.c. Any other option is read as
# taking none, so the value of an unlisted one counts as a file below and the
# request is refused; --option=value always works. tests/run.sh holds this list
# against the installed GnuPG, since a listed option that took no value would
# let a file through.
GPG_VALUE_OPTIONS=" agent-program attribute-fd attribute-file auto-key-locate cert-digest-algo charset command-fd command-file comment compliance compress-algo compress-level debug debug-level default-key default-sig-expire digest-algo display display-charset encrypt-to faked-system-time hidden-encrypt-to hidden-recipient hidden-recipient-file homedir input-size-hint keyid-format keyring lc-ctype lc-messages list-options local-user logger-fd logger-file max-output options output passphrase-fd passphrase-file passphrase-repeat personal-digest-preferences pinentry-mode recipient recipient-file secret-keyring sender set-filename set-notation set-policy-url sig-keyserver-url sig-notation sig-policy-url sign-with status-fd status-file trust-model trusted-key ttyname ttytype verify-options weak-digest xauthority "
# The short options that take a value, the same in both versions.
GPG_VALUE_SHORT_OPTIONS=FNRforuz

# Whether an option's value makes GPG read standard input before signing, so
# the signature would cover only what is left of it. GnuPG reads these fds as
# numbers, cut down to an int (so 4294967296 is 0), and takes any unique prefix
# of a long option's name. A link to /dev/stdin resolves to this wrapper's
# standard input here and to GPG's there, so -ef catches it either way.
value_reads_stdin() {
    case "$1" in
        --passphrase-fd|--command-fd|--override-session-key-|--override-session-key-f|--override-session-key-fd)
            [[ "$2" =~ ^[1-9][0-9]{0,8}$ ]] || return 0
            ;;
    esac
    # - and -&N name standard input or a descriptor, except as GPG's output.
    if [[ "$2" == '-&'* || ( "$2" == - && "$1" != -o && "$1" != --output ) ]]; then
        return 0
    fi
    [[ "$2" == /dev/stdin || "$2" == /dev/fd/0 || "$2" -ef /dev/stdin ]]
}

# The position of the first argument that would make GPG sign anything but the
# whole previewed standard input, if any; never its text, which may be a secret
# such as an unlisted option's value. Parsed the way GnuPG parses: a long option's value is
# the next argument unless written with =, a short option's value is the rest
# of its cluster or else the next argument, and -- ends the options. A lone -
# counts as a file too: it may be the value of an option missing from the list.
unpreviewed_input() {
    local arg rest option="" options_done=0 position=0
    for arg in "$@"; do
        position=$((position + 1))
        if [[ -n "$option" ]]; then
            if value_reads_stdin "$option" "$arg"; then
                printf '%d' "$position"
                return 0
            fi
            option=""
            continue
        fi
        if [[ "$options_done" -eq 0 ]]; then
            case "$arg" in
                --) options_done=1; continue ;;
                --*=*)
                    if value_reads_stdin "${arg%%=*}" "${arg#*=}"; then
                        printf '%d' "$position"
                        return 0
                    fi
                    continue
                    ;;
                --*)
                    if [[ "$arg" != *[[:space:]]* && "$GPG_VALUE_OPTIONS" == *" ${arg#--} "* ]]; then
                        option=$arg
                    fi
                    continue
                    ;;
                -?*)
                    rest=${arg#-}
                    while [[ -n "$rest" ]]; do
                        case "${rest:0:1}" in
                            [$GPG_VALUE_SHORT_OPTIONS])
                                if [[ "${#rest}" -eq 1 ]]; then
                                    option="-$rest"
                                elif value_reads_stdin "-${rest:0:1}" "${rest:1}"; then
                                    printf '%d' "$position"
                                    return 0
                                fi
                                break
                                ;;
                        esac
                        rest=${rest:1}
                    done
                    continue
                    ;;
            esac
        fi
        printf '%d' "$position"
        return 0
    done
    return 1
}

sanitize_stream() {
    /usr/bin/tr '\000-\010\013\014\016-\037\177' '?'
}

sanitize_one_line() {
    sanitize_stream | /usr/bin/tr '\n\r\t' '   '
}

valid_object_id() {
    [[ "$1" =~ ^[0-9A-Fa-f]{40}$ || "$1" =~ ^[0-9A-Fa-f]{64}$ ]]
}

fixture_style_commit_subject() {
    local message_file="$1"
    /usr/bin/awk -v subjects="$FIXTURE_SUBJECTS" '
        BEGIN { count = split(subjects, list, /\|/) }
        {
            subject = $0
            sub(/\r$/, "", subject)
            sub(/^[ \t]+/, "", subject)
            sub(/[ \t]+$/, "", subject)
            if (subject == "") {
                next
            }
            subject = tolower(subject)
            for (i = 1; i <= count; i++) {
                if (subject == list[i]) {
                    print subject
                    matched = 1
                    break
                }
            }
            exit
        }
        END { exit matched ? 0 : 1 }
    ' "$message_file"
}

fixture_style_commit_identity() {
    local payload_file="$1"
    /usr/bin/awk -v domains=" $FIXTURE_EMAIL_DOMAINS " '
        $0 == "" { exit }
        $1 == "author" || $1 == "committer" {
            line = $0
            open = 0
            for (i = length(line); i > 0; i--) {
                if (substr(line, i, 1) == "<") { open = i; break }
            }
            if (open == 0) { next }
            email = substr(line, open + 1)
            close_at = index(email, ">")
            if (close_at == 0) { next }
            email = tolower(substr(email, 1, close_at - 1))
            gsub(/^[ \t]+|[ \t]+$/, "", email)
            domain = email
            sub(/^.*@/, "", domain)
            sub(/\.$/, "", domain)
            count = split(substr(domains, 2, length(domains) - 2), list, " ")
            for (i = 1; i <= count; i++) {
                suffix = "." list[i]
                if (domain == list[i] || (length(domain) > length(suffix) && substr(domain, length(domain) - length(suffix) + 1) == suffix)) {
                    print email
                    matched = 1
                    exit
                }
            }
        }
        END { exit matched ? 0 : 1 }
    ' "$payload_file"
}

# Store literal lines, never patterns or shell code. ASCII case folding matches
# the remote service byte-for-byte; control characters cannot become rules.
spam_subject() {
    # macOS awk truncates at NUL. Never learn a shortened version of a subject.
    /usr/bin/tr -d '\000' < "$PAYLOAD" | /usr/bin/cmp -s "$PAYLOAD" - || return 0
    /usr/bin/awk '
        {
            subject = $0
            sub(/\r$/, "", subject)
            gsub(/^[ \t]+|[ \t]+$/, "", subject)
            if (subject == "") next
            if (subject !~ /[[:cntrl:]]/) print tolower(subject)
            exit
        }
    ' "$MESSAGE"
}

reject_spam_subject() {
    [[ -s "$SPAM_SUBJECT_FILE" ]] || return 0
    if [[ -e "$SPAM_FILE" || -L "$SPAM_FILE" ]]; then
        if [[ ! -f "$SPAM_FILE" || -L "$SPAM_FILE" || ! -r "$SPAM_FILE" ]]; then
            error "cannot read spam subject list: $SPAM_FILE; refusing to sign"
            exit 70
        fi
        /usr/bin/grep -Fqx -f "$SPAM_SUBJECT_FILE" "$SPAM_FILE"
        local status=$?
        if [[ "$status" -eq 0 ]]; then
            audit_decision "spam-reject" "$REPOSITORY" "$REQUEST_TYPE" "$PAYLOAD_SHA" || true
            error "subject marked as spam; remove its line from $SPAM_FILE to allow it again"
            exit 65
        elif [[ "$status" -ne 1 ]]; then
            error "cannot read spam subject list: $SPAM_FILE; refusing to sign"
            exit 70
        fi
    fi
}

remember_spam_subject() {
    # Caller holds dialog.lock, shared by local wrappers and the remote service.
    [[ -s "$SPAM_SUBJECT_FILE" ]] || return 1
    SPAM_TEMP=$(/usr/bin/mktemp "$SPAM_FILE.XXXXXX") || return 1
    if { [[ ! -e "$SPAM_FILE" && ! -L "$SPAM_FILE" ]] ||
         { [[ -f "$SPAM_FILE" && ! -L "$SPAM_FILE" ]] && /usr/bin/awk '1' "$SPAM_FILE" > "$SPAM_TEMP"; }; } &&
       /bin/cat "$SPAM_SUBJECT_FILE" >> "$SPAM_TEMP" &&
       /bin/chmod 600 "$SPAM_TEMP" && /bin/mv -f "$SPAM_TEMP" "$SPAM_FILE"; then
        SPAM_TEMP=""
        return 0
    fi
    /bin/rm -f "$SPAM_TEMP"
    SPAM_TEMP=""
    return 1
}

handle_operator_rejection() {
    case "$DECISION_VALUE" in
        cancel|spam)
            [[ -z "$CHILD_PID" ]] || stop_gpg "$CHILD_PID"
            flush_gpg_stderr
            if [[ "$DECISION_VALUE" == spam ]]; then
                if ! remember_spam_subject; then
                    audit_decision "spam-save-error" "$REPOSITORY" "$REQUEST_TYPE" "$PAYLOAD_SHA" || true
                    error "signing cancelled, but could not save spam subject to $SPAM_FILE"
                    exit 70
                fi
                audit_decision "spam-mark" "$REPOSITORY" "$REQUEST_TYPE" "$PAYLOAD_SHA" || true
                error "signing cancelled; subject marked as spam (edit $SPAM_FILE to undo)"
            else
                audit_decision "cancel" "$REPOSITORY" "$REQUEST_TYPE" "$PAYLOAD_SHA" || true
                error "signing cancelled by user"
            fi
            exit 1
            ;;
    esac
}

# The dialog marks a rejection before it writes one, and this script
# terminates the dialog as soon as GPG exits -- possibly between the two steps.
# Give an answer that is already in flight a bounded window to land, so a touch
# and a Cancel in the same instant cannot be misread as "no decision".
await_pending_decision() {
    [[ -e "$DECIDING" ]] || return 0
    local waited=0
    while [[ ! -s "$DECISION" ]]; do
        /bin/sleep 0.05
        waited=$((waited + 1))
        if [[ "$waited" -ge 40 ]]; then   # 2s
            break
        fi
    done
}

# GPG's stderr is held per attempt so a wrong-PIN attempt that is retried
# does not reach Git. Whatever attempt ends the request is forwarded once.
flush_gpg_stderr() {
    if [[ -n "$GPG_STDERR" && -f "$GPG_STDERR" ]]; then
        /bin/cat "$GPG_STDERR" >&2
    fi
    GPG_STDERR=""
}

# Locale is forced to C above, so GPG's text is not translated. The status
# line is what Git's --status-fd=2 produces; the text covers other callers.
bad_pin_failure() {
    [[ -n "$GPG_STDERR" && -f "$GPG_STDERR" ]] || return 1
    /usr/bin/grep -Eq '^\[GNUPG:\] SC_OP_FAILURE 2$|signing failed: Bad PIN$' "$GPG_STDERR"
}

# Runs a read-only query into a file. Bounded, so a wedged card or agent
# cannot hold the dialog lock forever. Fails when the query fails or is cut off.
run_query() {
    local output="$1" pid waited=0 status=0
    shift
    "$@" < /dev/null > "$output" 2>/dev/null 4>&- &
    pid=$!
    CHILD_PID=$pid
    while /bin/kill -0 "$pid" 2>/dev/null; do
        /bin/sleep 0.05
        waited=$((waited + 1))
        if [[ "$waited" -ge 200 ]]; then   # 10s
            /bin/kill -s TERM "$pid" 2>/dev/null || true
            break
        fi
    done
    wait "$pid" 2>/dev/null || status=$?
    CHILD_PID=""
    return "$status"
}

run_gpg_query() {
    local output="$1"
    shift
    run_query "$output" "$REAL_GPG" --batch "$@"
}

# The card's remaining PIN (PW1) attempts, or nothing when it cannot be read.
card_pin_retries() {
    run_gpg_query "$REQUEST_DIR/card-status" --card-status --with-colons
    /usr/bin/awk -F: '$1 == "pinretry" && $2 ~ /^[0-9]+$/ { print $2 + 0; exit }' "$REQUEST_DIR/card-status" 2>/dev/null
}

# The key GPG will sign with, judged from a --with-colons secret key listing:
# "<fingerprint> card" or "<fingerprint> software", or nothing when no key
# can sign. A selector ending in ! names that exact primary key or subkey.
# Any other selector, a subkey's own fingerprint included, takes the first
# matching certificate that can sign, and from it the newest usable signing
# subkey, or the primary key when no subkey can sign: GnuPG 2.2's choice.
# GnuPG 2.3 and later rank a key on a card above a software key whose
# passphrase is not cached, so whenever this picks a card key, GPG signs with
# a card key or asks for nothing. Any other pick keeps pinentry, which
# handles both. A listing always shows whole certificates, so the other keys
# in it never decide.
selected_signing_key() {
    local exact=""
    if [[ "$2" == *! ]]; then
        exact=${2%!}
        exact=${exact// /}
        exact=${exact#0[xX]}
    fi
    /usr/bin/awk -F: -v exact="$exact" -v now="$(/bin/date +%s)" '
        # Never an invalid, revoked or expired key (a primary key passes its
        # state on to its subkeys) or a stub without its secret part.
        function usable(i) { return valid[i] !~ /^[eri]$/ && caps[i] ~ /s/ && token[i] != "#" }
        function kind(i) { return token[i] != "" && token[i] != "+" ? "card" : "software" }
        function named(f,    e) {
            e = toupper(exact)
            if (e !~ /^[0-9A-F]+$/) return 0
            if (length(e) == length(f)) return e == f
            if (length(e) != 8 && length(e) != 16) return 0
            # A v4 key ID ends the fingerprint; a v5 key ID starts it.
            if (length(f) == 64) return substr(f, 1, length(e)) == e
            return substr(f, length(f) - length(e) + 1) == e
        }
        function decide(    i, best, unclear) {
            for (i = 2; i <= n; i++) {
                if (!usable(i)) continue
                # GPG skips a subkey from the future unless ignore-valid-from is set.
                if (created[i] + 0 > now + 0) unclear = 1
                if (!best || created[i] + 0 > created[best] + 0) best = i
            }
            if (!best && usable(1)) best = 1
            if (!best) return
            finished = 1
            if (!unclear) print fpr[best], kind(best)
            exit
        }
        $1 == "sec" { if (n && exact == "") decide(); n = 0 }
        $1 == "sec" || $1 == "ssb" {
            n++; valid[n] = $2; created[n] = $6; caps[n] = $12; token[n] = $15; fpr[n] = "-"; key = n
            next
        }
        $1 == "fpr" && key {
            fpr[key] = toupper($10)
            if (exact != "" && named(fpr[key]) && usable(key)) {
                finished = 1
                print fpr[key], kind(key)
                exit
            }
        }
        { key = 0 }
        END { if (!finished && n && exact == "") decide() }
    ' "$1" 2>/dev/null
}

# The key GPG will sign with, as selected_signing_key reports it, looked up
# once per request. Nothing for a request naming more than one key, since -u
# wins over --default-key and every -u key signs, or for a listing that
# failed or was cut off, since a missing key could be the one GPG picks.
look_up_signing_key() {
    [[ "$SIGNING_KEY_LOOKED_UP" -eq 0 ]] || return 0
    SIGNING_KEY_LOOKED_UP=1
    [[ "$KEY_SELECTORS" -eq 1 ]] || return 0
    run_gpg_query "$REQUEST_DIR/secret-keys" --with-colons --list-secret-keys -- "$KEY_SELECTOR" || return 0
    SIGNING_KEY=$(selected_signing_key "$REQUEST_DIR/secret-keys" "$KEY_SELECTOR")
}

# Whether the key GPG will sign with is stored on a card. Software keys keep
# gpg-agent's pinentry, which re-prompts for a wrong passphrase itself and has
# no minimum length. So does any request whose key cannot be told.
signing_key_on_card() {
    look_up_signing_key
    [[ "$SIGNING_KEY" == *" card" ]]
}

# gpg-connect-agent from real GPG's installation: beside it, or beside the
# file a symbolic link to it leads to.
gpg_connect_agent() {
    local path=$REAL_GPG dir hops=0
    while :; do
        dir=$(dirname -- "$path")
        if [[ -x "$dir/gpg-connect-agent" ]]; then
            printf '%s\n' "$dir/gpg-connect-agent"
            return 0
        fi
        [[ -L "$path" && "$hops" -lt 40 ]] || return 1
        hops=$((hops + 1))
        path=$(/usr/bin/readlink -- "$path") || return 1
        [[ "$path" == /* ]] || path="$dir/$path"
    done
}

# The touch policy of the key GPG will sign with, when that key is the
# signature key of the card in the reader: off, on, fixed, cached or
# cached-fixed, the YubiKey's UIF values 0 to 4. Nothing when that cannot be
# told: a software key, another card or none, a card without the setting, or
# no gpg-connect-agent. It is asked through gpg-agent because scdaemon holds
# the card; ykman would kill scdaemon to reach it. SERIALNO selects the card's
# OpenPGP application, as gpg does before it uses a card.
card_touch_policy() {
    local agent
    TOUCH_POLICY=""
    agent=$(gpg_connect_agent) || return 0
    look_up_signing_key
    [[ "$SIGNING_KEY" == *" card" ]] || return 0
    run_query "$REQUEST_DIR/card-touch" "$agent" 'SCD SERIALNO openpgp' 'SCD GETATTR KEY-FPR' 'SCD GETATTR UIF-1' /bye ||
        return 0
    # scdaemon escapes the raw UIF bytes: the policy byte, then 0x20 ("+").
    TOUCH_POLICY=$(/usr/bin/awk -v key="${SIGNING_KEY%% *}" '
        $1 == "S" && $2 == "KEY-FPR" && $3 == "1" { card = toupper($4) }
        $1 == "S" && $2 == "UIF-1" { uif = $3 }
        END {
            if (card != key || uif !~ /^%0[0-4]/) exit
            split("off on fixed cached cached-fixed", policy, " ")
            print policy[substr(uif, 3, 1) + 1]
        }
    ' "$REQUEST_DIR/card-touch" 2>/dev/null)
}

# What to tell the operator about a touch policy that is worth changing: off
# signs without any touch, and cached lets a request queued behind a touch sign
# without its own, so both need Sign. On already asks for a touch on every signature, and fixed and
# cached-fixed cannot be changed without replacing the key, so they get nothing.
# Two lines of at most 80 characters, the policy and then the command, so both
# fit the width of the preview's facts pane, which does not wrap.
touch_policy_notice() {
    case "$1" in
        off) printf '%s\n%s' "Touch policy is off: this key signs with no touch." \
            "To require one, run: ykman openpgp keys set-touch sig on" ;;
        cached) printf '%s\n%s' "Touch policy is cached: one touch signs for 15 seconds, so Sign is required." \
            "To require a touch for every signature, run: ykman openpgp keys set-touch sig on" ;;
        *) return 1 ;;
    esac
}

# Puts NOTICE above the facts in the preview's SUMMARY and above the report in
# its DETAILS: both or neither, so the two never disagree. Each new text goes to
# a private temporary file beside the old one (mktemp makes it 0600) and then
# over it; a summary already replaced goes back if the details cannot follow.
# Advisory: on a failure both files keep their text, no temporary file stays,
# and stderr says so. The Sign gate for touch off does not depend on this.
prepend_touch_notice() {
    local notice="$1" summary="$2" details="$3" new_summary="" new_details="" old_summary=""
    if new_summary=$(/usr/bin/mktemp "$summary.XXXXXX" 2>/dev/null) &&
       new_details=$(/usr/bin/mktemp "$details.XXXXXX" 2>/dev/null) &&
       old_summary=$(/usr/bin/mktemp "$summary.XXXXXX" 2>/dev/null) &&
       { printf '%s\n\n' "$notice"; /bin/cat "$summary"; } 2>/dev/null > "$new_summary" &&
       { printf '%s\n\n' "$notice"; /bin/cat "$details"; } 2>/dev/null > "$new_details" &&
       /bin/ln -f "$summary" "$old_summary" 2>/dev/null &&
       /bin/mv -f "$new_summary" "$summary" 2>/dev/null; then
        if /bin/mv -f "$new_details" "$details" 2>/dev/null; then
            /bin/rm -f "$old_summary"
            return 0
        fi
        if ! /bin/mv -f "$old_summary" "$summary" 2>/dev/null; then
            /bin/rm -f "$new_details" "$old_summary"
            error "note: the touch policy notice is in the preview but not in its details"
            return 0
        fi
    fi
    /bin/rm -f "$new_summary" "$new_details" "$old_summary"
    error "note: could not add the touch policy notice to the preview or its details"
}

# Ends what a GPG stopped mid-signature (a timeout, Cancel, Mark as Spam, or a
# preview or PIN window closed without an answer) left at the card. gpg-agent
# and scdaemon keep its request, and any PIN request scdaemon made, alive: the next
# touch would complete that stale operation, or find the card busy. Stopping
# scdaemon, as gpgconf --kill scdaemon does, ends both; gpg-agent starts it
# again for the next request, which may ask for the PIN again. Bounded, and
# done before the dialog lock goes to the next request.
cancel_card_operation() {
    local agent
    agent=$(gpg_connect_agent) || return 0
    run_query /dev/null "$agent" 'SCD KILLSCD' /bye || true
}

# Stops GPG at PID and, when it was still running, the operation it may have
# left waiting at the card, before the dialog lock goes to the next request.
stop_gpg() {
    local pid="$1"
    if /bin/kill -0 "$pid" 2>/dev/null; then
        /bin/kill -s TERM "$pid" 2>/dev/null || true
        wait "$pid" 2>/dev/null || true
        cancel_card_operation
    else
        wait "$pid" 2>/dev/null || true
    fi
    CHILD_PID=""
}

# Whether the request names its own home directory, keyring or options file.
# What this wrapper looks up would then describe keys GPG does not use.
names_own_gnupg_files() {
    local arg
    for arg in "$@"; do
        case "$arg" in
            --homedir|--homedir=*|--keyring|--keyring=*|--no-default-keyring|--options|--options=*) return 0 ;;
            --) break ;;
        esac
    done
    return 1
}

# The wrapper's own PIN window replaces gpg-agent's pinentry when the key is
# on a card, GPG reports its status on stderr (Git always passes
# --status-fd=2) and the caller has not chosen its own PIN handling. GPG then asks for the PIN on stderr
# (GET_HIDDEN) and reads it from fd 3, a pipe the PIN window writes into.
uses_builtin_pin_entry() {
    [[ "$PIN_PROMPT" == builtin ]] || return 1
    names_own_gnupg_files "$@" && return 1
    local arg status_on_stderr=0 expect_status_fd=0
    for arg in "$@"; do
        if [[ "$expect_status_fd" -eq 1 ]]; then
            [[ "$arg" == 2 ]] && status_on_stderr=1
            expect_status_fd=0
            continue
        fi
        case "$arg" in
            --status-fd=2) status_on_stderr=1 ;;
            --status-fd) expect_status_fd=1 ;;
            --pinentry-mode|--pinentry-mode=*|--command-fd|--command-fd=*|--command-file*|--passphrase*) return 1 ;;
            --) break ;;
        esac
    done
    [[ "$status_on_stderr" -eq 1 ]] && signing_key_on_card
}

dismiss_pin_entry() {
    if [[ -n "$PIN_DIALOG_PID" ]] && /bin/kill -0 "$PIN_DIALOG_PID" 2>/dev/null; then
        /bin/kill -s TERM "$PIN_DIALOG_PID" 2>/dev/null || true
        wait "$PIN_DIALOG_PID" 2>/dev/null || true
    fi
    PIN_DIALOG_PID=""
}

# Called while GPG runs. Opens the PIN window when GPG asks for the PIN.
# Fails when the window closed without sending a PIN, or when GPG asks a
# yes/no or text question on the PIN pipe (in loopback mode an agent prompt
# such as "insert card" arrives this way), because GPG would otherwise wait
# forever for an answer only the PIN window could give.
poll_pin_entry() {
    if [[ -n "$PIN_DIALOG_PID" ]]; then
        /bin/kill -0 "$PIN_DIALOG_PID" 2>/dev/null && return 0
        wait "$PIN_DIALOG_PID" 2>/dev/null || true
        PIN_DIALOG_PID=""
        [[ "$(/bin/cat "$PIN_RESULT" 2>/dev/null)" == entered ]]
        return
    fi
    local asked question
    question=$(/usr/bin/sed -nE 's/^\[GNUPG:\] (GET_BOOL|GET_LINE) ([A-Za-z0-9._-]*).*/\1 \2/p' "$GPG_STDERR" 2>/dev/null | /usr/bin/head -n 1)
    if [[ -n "$question" ]]; then
        UNANSWERABLE_PROMPT=$question
        return 1
    fi
    asked=$(/usr/bin/grep -c '^\[GNUPG:\] GET_HIDDEN passphrase\.enter$' "$GPG_STDERR" 2>/dev/null) || asked=0
    if [[ "$asked" -gt "$PIN_PROMPTS_SHOWN" ]]; then
        PIN_PROMPTS_SHOWN=$asked
        : > "$PIN_RESULT"
        /usr/bin/osascript -l JavaScript "$UI_HELPER" --pin-entry "$PIN_CHANNEL" "$PIN_RESULT" \
            "${PIN_REMAINING_BEFORE:-unknown}" "$ATTEMPT" >/dev/null 2>&1 4>&- &
        PIN_DIALOG_PID=$!
    fi
    return 0
}

# Reads the preview's answer into DECISION_VALUE. Only the exact bytes "sign"
# count as Sign: no case folding, no whitespace, and nothing that a command
# substitution would quietly drop, such as a trailing newline or a NUL. Other
# answers keep the plain read, so a rejection can never be read as no answer.
read_decision() {
    { DECISION_VALUE=$(/bin/cat "$DECISION" 2>/dev/null || true); } 2>/dev/null
    if [[ "$DECISION_VALUE" == sign ]] && ! printf sign | /usr/bin/cmp -s - "$DECISION"; then
        DECISION_VALUE=invalid
    fi
}

# With touch off, cached, cached-fixed or unknown, GPG starts only after the
# operator clicks Sign: the key could otherwise sign the moment GPG asked it,
# before anyone could read the preview. Only on and fixed keep the touch as
# the gate.
# Waits for the preview to close, at most SIGN_CLICK_SECONDS. Anything but Sign
# (Cancel, Mark as Spam, a window closed without an answer, or no answer in
# time) ends the request unsigned, and GPG never started.
await_sign_click() {
    # Ticks of 0.1s, not whole seconds, so the window is never shorter than
    # SIGN_CLICK_SECONDS. A preview that has closed is read first: its answer
    # came in time. One still open at the deadline is stopped and ignored.
    local waited=0
    while /bin/kill -0 "$DIALOG_PID" 2>/dev/null && [[ "$waited" -lt $((SIGN_CLICK_SECONDS * 10)) ]]; do
        /bin/sleep 0.1
        waited=$((waited + 1))
    done
    if /bin/kill -0 "$DIALOG_PID" 2>/dev/null; then
        /bin/kill -s TERM "$DIALOG_PID" 2>/dev/null || true
        wait "$DIALOG_PID" 2>/dev/null || true
        DECISION_VALUE=timeout
    else
        wait "$DIALOG_PID" 2>/dev/null || true
        read_decision
    fi
    DIALOG_PID=""
    [[ "$DECISION_VALUE" == sign && ! -e "$DECIDING" ]] && return 0
    error "not signed: touch policy is ${TOUCH_POLICY:-unknown} and Sign was not clicked"
    handle_operator_rejection
    release_dialog_lock
    audit_decision "sign-not-clicked" "$REPOSITORY" "$REQUEST_TYPE" "$PAYLOAD_SHA" || true
    exit 70
}

# After a wrong PIN: tell the user how many attempts the key has left and let
# them try again. Succeeds only on an explicit Try Again while the key still
# has attempts; the next attempt asks for the PIN in a new, empty field.
offer_pin_retry() {
    local remaining allow=retry choice remaining_text counted=counted
    remaining=$(card_pin_retries)
    [[ -n "$remaining" ]] || remaining=unknown
    # A PIN that never reached the key leaves its counter unchanged.
    if [[ "$remaining" != unknown && "$remaining" == "${PIN_REMAINING_BEFORE:-}" ]]; then
        counted=uncounted
    fi
    if [[ "$remaining" == unknown ]]; then
        # Without the card's counter, earlier requests may already have used
        # attempts, so a second wrong PIN here could be the one that blocks
        # the key. Allow one retry only.
        [[ "$ATTEMPT" -lt 2 ]] || allow=final
    elif [[ "$remaining" -eq 0 || "$ATTEMPT" -ge "$PIN_ATTEMPT_LIMIT" ]]; then
        allow=final
    fi
    if [[ "$remaining" == unknown ]]; then
        remaining_text="remaining attempts unknown"
    elif [[ "$remaining" -eq 1 ]]; then
        remaining_text="1 PIN attempt remaining"
    else
        remaining_text="$remaining PIN attempts remaining"
    fi

    : > "$PIN_DECISION"
    /usr/bin/osascript -l JavaScript "$UI_HELPER" --pin-error "$PIN_DECISION" "$remaining" "$allow" "$counted" >/dev/null 2>&1 4>&- &
    DIALOG_PID=$!
    wait "$DIALOG_PID" 2>/dev/null || true
    DIALOG_PID=""
    choice=$(/bin/cat "$PIN_DECISION" 2>/dev/null || true)

    if [[ "$allow" == retry && "$choice" == retry ]]; then
        audit_decision "bad-pin-retry" "$REPOSITORY" "$REQUEST_TYPE" "$PAYLOAD_SHA" || true
        PREVIEW_SUMMARY="$REQUEST_DIR/summary-attempt-$((ATTEMPT + 1)).txt"
        {
            if [[ "$counted" == uncounted ]]; then
                printf 'PIN attempt %d: the previous PIN was rejected before reaching the key (%s).\n\n' "$((ATTEMPT + 1))" "$remaining_text"
            else
                printf 'PIN attempt %d: the previous PIN was incorrect (%s).\n\n' "$((ATTEMPT + 1))" "$remaining_text"
            fi
            /bin/cat "$SUMMARY"
        } > "$PREVIEW_SUMMARY"
        return 0
    fi

    audit_decision "bad-pin" "$REPOSITORY" "$REQUEST_TYPE" "$PAYLOAD_SHA" || true
    if [[ "$remaining" == 0 ]]; then
        error "incorrect PIN; the key's PIN is now blocked (unblock with the Admin PIN: gpg --card-edit, admin, passwd, 2; or with a Reset Code: gpg --card-edit, unblock)"
    else
        error "incorrect PIN; signing cancelled ($remaining_text)"
    fi
    return 1
}

append_limited_sanitized() {
    local source="$1" limit="$2"
    /usr/bin/head -c "$limit" "$source" | sanitize_stream
    local size
    size=$(/usr/bin/wc -c < "$source" | /usr/bin/tr -d ' ')
    if [[ "$size" -gt "$limit" ]]; then
        printf '\n[truncated in summary; View Details shows the complete report]\n'
    fi
}

acquire_dialog_lock() {
    if [[ -z "$LOCK_ROOT" ]]; then
        LOCK_ROOT="$HOME/Library/Caches/git-gpg-preview"
    fi
    if [[ "$LOCK_ROOT" != /* ]]; then
        error "lock_root must be an absolute path"
        return 1
    fi
    if [[ -L "$LOCK_ROOT" ]]; then
        error "lock_root must not be a symbolic link"
        return 1
    fi
    /bin/mkdir -p "$LOCK_ROOT" || return 1
    /bin/chmod 700 "$LOCK_ROOT" || return 1
    LOCK_FILE="$LOCK_ROOT/dialog.lock"
    while ! /usr/bin/shlock -p "$$" -f "$LOCK_FILE" >/dev/null 2>&1; do
        /bin/sleep 0.2
    done
    LOCK_HELD=1
    return 0
}

release_dialog_lock() {
    if [[ "$LOCK_HELD" -eq 1 ]]; then
        local owner=""
        owner=$(/bin/cat "$LOCK_FILE" 2>/dev/null || true)
        if [[ "$owner" == "$$" ]]; then
            /bin/rm -f "$LOCK_FILE"
        fi
        LOCK_HELD=0
    fi
}

audit_decision() {
    local decision="$1" repo="$2" kind="$3" hash="$4"
    [[ -z "$AUDIT_LOG" ]] && return 0
    if [[ "$AUDIT_LOG" != /* ]]; then
        error "audit_log must be empty or an absolute path"
        return 1
    fi
    local audit_dir caller safe_repo safe_caller timestamp
    audit_dir=$(dirname -- "$AUDIT_LOG")
    /bin/mkdir -p "$audit_dir" || return 1
    /bin/chmod 700 "$audit_dir" || return 1
    : >> "$AUDIT_LOG" || return 1
    /bin/chmod 600 "$AUDIT_LOG" || return 1
    caller=$(/bin/ps -p "$PPID" -o comm= 2>/dev/null || printf 'pid:%s' "$PPID")
    safe_repo=$(printf '%s' "$repo" | sanitize_one_line)
    safe_caller=$(printf '%s' "$caller" | sanitize_one_line)
    timestamp=$(/bin/date -u '+%Y-%m-%dT%H:%M:%SZ')
    printf '%s\trepository=%s\ttype=%s\tpayload_sha256=%s\tcaller_pid=%s\tcaller=%s\tdecision=%s\n' \
        "$timestamp" "$safe_repo" "$kind" "$hash" "$PPID" "$safe_caller" "$decision" >> "$AUDIT_LOG"
}

if ! read_config; then
    exit 70
fi

if ! is_signing_request "$@"; then
    exec "$REAL_GPG" "$@"
fi

if [[ -z "$UI_HELPER" || "$UI_HELPER" != /* || ! -f "$UI_HELPER" ]]; then
    error "missing or invalid UI helper configuration"
    exit 70
fi

TEMP_BASE=${TMPDIR:-/tmp}
if [[ ! -d "$TEMP_BASE" ]]; then
    error "temporary directory is unavailable"
    exit 70
fi
REQUEST_DIR=$(/usr/bin/mktemp -d "${TEMP_BASE%/}/git-gpg-preview.XXXXXX") || {
    error "could not create a secure request directory"
    exit 70
}
/bin/chmod 700 "$REQUEST_DIR" || exit 70

PAYLOAD="$REQUEST_DIR/payload"
SUMMARY="$REQUEST_DIR/summary.txt"
DETAILS="$REQUEST_DIR/details.txt"
MESSAGE="$REQUEST_DIR/message.txt"
DIFFSTAT="$REQUEST_DIR/diffstat.txt"
FULL_DIFF="$REQUEST_DIR/full-diff.txt"
DECISION="$REQUEST_DIR/decision"
DECIDING="$DECISION.deciding"
SPAM_SUBJECT_FILE="$REQUEST_DIR/spam-subject"
: > "$PAYLOAD"
/bin/chmod 600 "$PAYLOAD"
/bin/cat > "$PAYLOAD" || {
    error "could not capture signing payload"
    exit 70
}

BYTE_COUNT=$(/usr/bin/wc -c < "$PAYLOAD" | /usr/bin/tr -d ' ')
PAYLOAD_SHA=$(/usr/bin/shasum -a 256 "$PAYLOAD" | /usr/bin/awk '{print $1}')

REPOSITORY="(not in a Git worktree)"
BRANCH="(not on a branch)"
if repo_value=$(git --no-pager rev-parse --show-toplevel 2>/dev/null); then
    REPOSITORY=$repo_value
elif repo_value=$(git --no-pager rev-parse --absolute-git-dir 2>/dev/null); then
    REPOSITORY=$repo_value
fi
if branch_value=$(git --no-pager symbolic-ref --quiet --short HEAD 2>/dev/null); then
    BRANCH=$branch_value
elif branch_value=$(git --no-pager rev-parse --short HEAD 2>/dev/null); then
    BRANCH="detached at $branch_value"
fi

KEY_SELECTOR="(not supplied)"
KEY_SELECTORS=0
expect_key=0
for arg in "$@"; do
    if [[ "$expect_key" -eq 1 ]]; then
        KEY_SELECTOR=$arg
        KEY_SELECTORS=$((KEY_SELECTORS + 1))
        expect_key=0
        continue
    fi
    case "$arg" in
        -u|--local-user|--default-key) expect_key=1 ;;
        --local-user=*|--default-key=*) KEY_SELECTOR=${arg#*=}; KEY_SELECTORS=$((KEY_SELECTORS + 1)) ;;
        -[!-]*u) expect_key=1 ;;
    esac
done

REQUEST_TYPE="unknown"
TREE_HASH=""
OBJECT_HASH=""
PARENTS=()
PARENT_COUNT=0
FIRST_LINE=$(/usr/bin/sed -n '1p' "$PAYLOAD")

if [[ "$FIRST_LINE" == tree\ * ]]; then
    REQUEST_TYPE="commit"
    TREE_HASH=$(/usr/bin/awk 'NF == 0 { exit } $1 == "tree" { print $2; exit }' "$PAYLOAD")
    while IFS= read -r parent; do
        if [[ -n "$parent" ]]; then
            PARENTS+=("$parent")
            PARENT_COUNT=$((PARENT_COUNT + 1))
        fi
    done < <(/usr/bin/awk 'NF == 0 { exit } $1 == "parent" { print $2 }' "$PAYLOAD")
elif [[ "$FIRST_LINE" == object\ * ]] && /usr/bin/awk 'NF == 0 { exit } $1 == "tag" { found=1; exit } END { exit found ? 0 : 1 }' "$PAYLOAD"; then
    REQUEST_TYPE="tag"
    OBJECT_HASH=$(/usr/bin/awk 'NF == 0 { exit } $1 == "object" { print $2; exit }' "$PAYLOAD")
elif [[ "$FIRST_LINE" == certificate\ version\ * ]]; then
    REQUEST_TYPE="push certificate"
fi

# GPG must sign exactly the previewed standard input. A file named in the
# arguments, or an option that reads part of standard input first, would get
# something else signed behind a preview of it.
if unpreviewed=$(unpreviewed_input "$@"); then
    audit_decision "input-reject" "$REPOSITORY" "$REQUEST_TYPE" "$PAYLOAD_SHA" || true
    error "refusing to sign: argument $unpreviewed would make GPG sign something other than the previewed standard input"
    error "pass the payload on standard input with no file arguments, and write option values as --option=value"
    exit 65
fi

/usr/bin/awk 'body { print; next } $0 == "" { body=1 }' "$PAYLOAD" > "$MESSAGE"
: > "$SPAM_SUBJECT_FILE"
if [[ "$REQUEST_TYPE" == commit ]]; then
    spam_subject > "$SPAM_SUBJECT_FILE"
    reject_spam_subject
fi
: > "$DIFFSTAT"
: > "$FULL_DIFF"

if [[ "$REQUEST_TYPE" == "commit" ]]; then
    FIXTURE_REASON=""
    if rejected_value=$(fixture_style_commit_subject "$MESSAGE"); then
        FIXTURE_REASON="subject '$rejected_value'"
    elif rejected_value=$(fixture_style_commit_identity "$PAYLOAD"); then
        FIXTURE_REASON="identity '$(printf '%s' "$rejected_value" | sanitize_one_line)'"
    fi
    if [[ -n "$FIXTURE_REASON" ]]; then
        # GIT_GPG_PREVIEW_ALLOW_SUBJECT is the original name of the override.
        if [[ "${GIT_GPG_PREVIEW_ALLOW_FIXTURE:-}" == "1" || "${GIT_GPG_PREVIEW_ALLOW_SUBJECT:-}" == "1" ]]; then
            # Deliberate one-shot override for a legitimate commit that
            # happens to match a fixture rule. Loud and audited.
            audit_decision "policy-override" "$REPOSITORY" "$REQUEST_TYPE" "$PAYLOAD_SHA" || true
            error "note: local fixture policy overridden for commit $FIXTURE_REASON (recorded in audit log); remote signing policy still applies"
        else
            audit_decision "policy-reject" "$REPOSITORY" "$REQUEST_TYPE" "$PAYLOAD_SHA" || true
            error "refusing to sign fixture-style commit $FIXTURE_REASON"
            error "if this is a test or fixture repository: disable signing there (run the test with GIT_CONFIG_GLOBAL=/dev/null, or set commit.gpgSign=false only in that repository)"
            error "if this is a real commit: give it a descriptive subject (e.g. 'Initial commit: <what this is>') and an identity outside the blocked domains; for local GnuPG only, re-run once with GIT_GPG_PREVIEW_ALLOW_FIXTURE=1 (audited override; remote signing has no fixture override)"
            exit 65
        fi
    fi
    if ! valid_object_id "$TREE_HASH" || ! git --no-pager cat-file -e "${TREE_HASH}^{tree}" 2>/dev/null; then
        error "commit payload has an invalid or unavailable tree; refusing to sign"
        exit 65
    fi
    if [[ "$PARENT_COUNT" -gt 0 ]]; then
        for parent in "${PARENTS[@]}"; do
            if ! valid_object_id "$parent" || ! git --no-pager cat-file -e "${parent}^{commit}" 2>/dev/null; then
                error "commit payload has an invalid or unavailable parent; refusing to sign"
                exit 65
            fi
        done
    fi

    BASES=()
    if [[ "$PARENT_COUNT" -eq 0 ]]; then
        EMPTY_TREE=$(git --no-pager hash-object -t tree --stdin </dev/null 2>/dev/null) || {
            error "could not derive the empty tree for an initial commit"
            exit 65
        }
        BASES+=("$EMPTY_TREE")
    else
        BASES=("${PARENTS[@]}")
    fi

    index=0
    for base in "${BASES[@]}"; do
        index=$((index + 1))
        if [[ "$PARENT_COUNT" -eq 0 ]]; then
            label="Initial commit (empty tree to proposed tree)"
        elif [[ "$PARENT_COUNT" -eq 1 ]]; then
            label="Changes from parent $base"
        else
            label="Changes from parent $index: $base"
        fi
        printf '%s\n' "$label" >> "$DIFFSTAT"
        if ! git --no-pager diff --stat --summary --no-ext-diff --no-textconv --no-color "$base" "$TREE_HASH" -- >> "$DIFFSTAT" 2>"$REQUEST_DIR/diff-error"; then
            error "could not safely derive the commit diffstat; refusing to sign"
            exit 65
        fi
        printf '%s\n\n' "$label" >> "$FULL_DIFF"
        if ! git --no-pager diff --no-ext-diff --no-textconv --no-color "$base" "$TREE_HASH" -- >> "$FULL_DIFF" 2>"$REQUEST_DIR/diff-error"; then
            error "could not safely derive the full commit diff; refusing to sign"
            exit 65
        fi
        printf '\n' >> "$DIFFSTAT"
        printf '\n' >> "$FULL_DIFF"
    done
elif [[ "$REQUEST_TYPE" == "tag" ]]; then
    if ! valid_object_id "$OBJECT_HASH" || ! git --no-pager cat-file -e "$OBJECT_HASH" 2>/dev/null; then
        error "tag payload has an invalid or unavailable target object; refusing to sign"
        exit 65
    fi
fi

SAFE_REPOSITORY=$(printf '%s' "$REPOSITORY" | sanitize_one_line)
SAFE_BRANCH=$(printf '%s' "$BRANCH" | sanitize_one_line)
SAFE_KEY=$(printf '%s' "$KEY_SELECTOR" | sanitize_one_line)

{
    printf 'Request type: %s\n' "$REQUEST_TYPE"
    printf 'Branch: %s\n' "$SAFE_BRANCH"
    printf 'Signing key: %s\n' "$SAFE_KEY"
    printf 'Exact payload: %s bytes\n' "$BYTE_COUNT"
    printf 'SHA-256: %s\n' "$PAYLOAD_SHA"
    # dialog.jxa splits the preview at this line, so every line above it must
    # stay a single sanitized line.
    printf '\nMessage:\n'
    append_limited_sanitized "$MESSAGE" 4000
} > "$SUMMARY"

{
    printf 'GIT OPENPGP SIGNING REVIEW — FULL DETAILS\n\n'
    printf 'Request type: %s\n' "$REQUEST_TYPE"
    printf 'Repository/worktree: %s\n' "$SAFE_REPOSITORY"
    printf 'Branch: %s\n' "$SAFE_BRANCH"
    printf 'Signing-key selector: %s\n' "$SAFE_KEY"
    printf 'Exact payload: %s bytes\n' "$BYTE_COUNT"
    printf 'Exact payload SHA-256: %s\n' "$PAYLOAD_SHA"
    if [[ -n "$TREE_HASH" ]]; then
        printf 'Tree: %s\n' "$TREE_HASH"
        if [[ "$PARENT_COUNT" -eq 0 ]]; then
            printf 'Parents: (initial commit; none)\n'
        else
            printf 'Parents/objects:\n'
            for parent in "${PARENTS[@]}"; do printf '  %s\n' "$parent"; done
        fi
    elif [[ -n "$OBJECT_HASH" ]]; then
        printf 'Target object: %s\n' "$OBJECT_HASH"
    fi
    printf '\nEXACT vs. DERIVED\n'
    printf 'GPG will receive only the exact captured payload identified above.\n'
    if [[ "$REQUEST_TYPE" == "commit" ]]; then
        printf 'The tree hash commits to file content. The diff below is reconstructed from Git objects for review and is not literally part of GPG input.\n'
    else
        printf 'Any labels or summaries below are derived for review and are not added to GPG input.\n'
    fi
    printf '\nCOMMIT/TAG MESSAGE OR PAYLOAD BODY\n'
    append_limited_sanitized "$MESSAGE" 4000
    if [[ "$REQUEST_TYPE" == "commit" ]]; then
        printf '\n\nDERIVED CHANGED-FILE SUMMARY / DIFFSTAT\n'
        append_limited_sanitized "$DIFFSTAT" 12000
    fi
    printf '\n\n============================================================\n'
    printf 'EXACT SIGNED PAYLOAD — VERBATIM BYTES BETWEEN MARKERS\n'
    printf 'Only these captured bytes are passed to GPG.\n'
    printf '============================================================\n'
    /bin/cat "$PAYLOAD"
    printf '\n============================================================\n'
    printf 'END EXACT SIGNED PAYLOAD\n'
    printf '============================================================\n\n'
    printf 'BYTE-PRESERVING HEX VIEW OF EXACT PAYLOAD\n\n'
    /usr/bin/hexdump -C "$PAYLOAD"
    if [[ "$REQUEST_TYPE" == "commit" ]]; then
        printf '\n============================================================\n'
        printf 'DERIVED FULL DIFF — REVIEW AID, NOT LITERAL GPG INPUT\n'
        printf 'Generated with git --no-pager, --no-ext-diff, and --no-textconv.\n'
        printf 'The signed tree hash commits to the resulting file content.\n'
        printf '============================================================\n'
        /bin/cat "$FULL_DIFF"
    fi
} > "$DETAILS"
/bin/chmod 600 "$SUMMARY" "$DETAILS" "$MESSAGE" "$DIFFSTAT" "$FULL_DIFF"
: > "$DECISION"
/bin/chmod 600 "$DECISION"

if ! acquire_dialog_lock; then
    error "could not acquire the signing-preview dialog lock"
    exit 70
fi
# Another request may have marked this subject while we waited for the lock.
reject_spam_subject

# Show the preview and engage real GPG concurrently. GPG blocks on the
# hardware confirmation (and the PIN only when the agent has not cached it),
# so the review window stays up while the device waits for a touch. Touching
# the key completes the signature and the window is dismissed. Cancel kills
# GPG before it can produce a signature, so Git aborts. The physical
# confirmation, not a software button, is the authorization gate.
#
# Except with touch policy off, cached, cached-fixed, or one that could not be
# read: then the key may sign without a touch of its own, and GPG would sign
# before the preview could be read. The preview then has a Sign button, which
# is the gate: GPG starts only after Sign is clicked, and Cancel, a closed
# window or no click within SIGN_CLICK_SECONDS leaves the request unsigned.
# Only on and fixed keep the touch as the gate.
#
# The preview is started first and reports readiness; only then is GPG
# engaged. This ordering means the PIN prompt (the PIN window or pinentry) launches last and
# stays frontmost and focused instead of appearing behind the preview.
#
# A wrong PIN does not end the request: the wrapper shows how many attempts
# the key has left and, on Try Again, repeats the preview and GPG with the
# same payload. The lock stays held, so queued requests keep waiting.
READY="$REQUEST_DIR/ready"
GPG_STDOUT="$REQUEST_DIR/gpg.stdout"
PIN_DECISION="$REQUEST_DIR/pin-decision"
SPAM_ACTION=""
[[ -s "$SPAM_SUBJECT_FILE" ]] && SPAM_ACTION="mark-spam"
PREVIEW_SUMMARY="$SUMMARY"
GPG_ARGS=("$@")
BUILTIN_PIN=0
if uses_builtin_pin_entry "$@"; then
    BUILTIN_PIN=1
    PIN_RESULT="$REQUEST_DIR/pin-result"
    GPG_ARGS=(--pinentry-mode loopback --command-fd 3 "$@")
fi
# Read under the lock, like the PIN counter: the card is busy while another
# request waits for its touch. The notice is two lines above the facts in every
# preview of this request and above its details, and one on stderr, which Git
# shows only when signing fails. Advisory: signing goes ahead under the key's
# current policy.
names_own_gnupg_files "$@" || card_touch_policy
if TOUCH_NOTICE=$(touch_policy_notice "$TOUCH_POLICY"); then
    prepend_touch_notice "$TOUCH_NOTICE" "$SUMMARY" "$DETAILS"
    # The newline goes through a variable, which keeps the pattern plain for
    # macOS's bash 3.2: no $'...' quoting inside a double-quoted expansion.
    NEWLINE=$'\n'
    error "note: ${TOUCH_NOTICE//$NEWLINE/ }"
fi
# Decided by the policy read from the card, never by whether the notice could
# be written, and never by the notice text: the preview gets that directly.
# Only on and fixed make every signature wait for its own touch, so only they
# keep the touch as the gate. Cached lets one touch sign whatever follows for
# 15 seconds, including touches made outside this tool, which no record here
# could see; off needs no touch; and anything that could not be read (a
# software key, another card, a query that failed or took too long) may be
# either. All of those need Sign.
case "$TOUCH_POLICY" in
    on|fixed) ;;
    off|cached) SIGN_GATE=1; SIGN_NOTICE=$TOUCH_NOTICE ;;
    cached-fixed) SIGN_GATE=1; SIGN_NOTICE=$CACHED_FIXED_TOUCH_NOTICE ;;
    *) SIGN_GATE=1; SIGN_NOTICE=$UNKNOWN_TOUCH_NOTICE ;;
esac
ATTEMPT=1
while :; do
    # Each attempt starts with a fresh, unanswered preview.
    : > "$DECISION"
    /bin/rm -f "$DECIDING" "$READY" "$GPG_STDOUT"
    if [[ "$BUILTIN_PIN" -eq 1 ]]; then
        # A pipe, so the PIN only ever exists in memory. The wrapper keeps it
        # open so GPG never reads end-of-file before the PIN window answers.
        # Each attempt gets a new pipe: a PIN sent as the previous attempt
        # ended must never be read by the next attempt's GPG.
        exec 4>&-
        [[ -z "${PIN_CHANNEL:-}" ]] || /bin/rm -f "$PIN_CHANNEL"
        PIN_CHANNEL="$REQUEST_DIR/pin-channel-$ATTEMPT"
        if ! /usr/bin/mkfifo -m 600 "$PIN_CHANNEL" || ! exec 4<>"$PIN_CHANNEL"; then
            error "could not create the PIN channel; refusing to sign"
            exit 70
        fi
    fi
    PIN_PROMPTS_SHOWN=0
    # Read before GPG starts: the card is busy while GPG waits for the PIN.
    # The PIN window shows it, and after a wrong PIN an unchanged count means
    # the PIN never reached the key (pinentry lets through PINs that are too
    # short; scdaemon then rejects them without asking the card).
    PIN_REMAINING_BEFORE=$(card_pin_retries)
    PREVIEW_ARGS=("$PREVIEW_SUMMARY" "$DETAILS" "$DECISION" "$READY" "$SPAM_ACTION")
    [[ "$SIGN_GATE" -eq 0 ]] || PREVIEW_ARGS+=(require-sign "$SIGN_NOTICE")
    /usr/bin/osascript -l JavaScript "$UI_HELPER" "${PREVIEW_ARGS[@]}" >/dev/null 2>&1 4>&- &
    DIALOG_PID=$!

    ready_waited=0
    while [[ ! -e "$READY" ]]; do
        if ! /bin/kill -0 "$DIALOG_PID" 2>/dev/null; then
            break
        fi
        /bin/sleep 0.05
        ready_waited=$((ready_waited + 1))
        if [[ "$ready_waited" -ge 100 ]]; then
            break
        fi
    done
    [[ "$SIGN_GATE" -eq 0 ]] || await_sign_click

    # Hold the output until the final decision check, so a simultaneous touch
    # and rejection cannot leak a signature to Git.
    GPG_STDERR="$REQUEST_DIR/gpg.stderr"
    if [[ "$BUILTIN_PIN" -eq 1 ]]; then
        "$REAL_GPG" "${GPG_ARGS[@]}" < "$PAYLOAD" > "$GPG_STDOUT" 2> "$GPG_STDERR" 3<&4 4>&- &
    else
        "$REAL_GPG" "${GPG_ARGS[@]}" < "$PAYLOAD" > "$GPG_STDOUT" 2> "$GPG_STDERR" &
    fi
    GPG_PID=$!
    CHILD_PID=$GPG_PID

    OUTCOME=""
    DECISION_VALUE=""
    GPG_STATUS=0
    if [[ "$SIGN_GATE" -eq 1 ]]; then
        # Sign was clicked and the preview has closed: only GPG is left to wait for.
        OUTCOME="dialog"
        DECISION_VALUE="sign"
    fi
    while [[ -z "$OUTCOME" ]]; do
        if ! /bin/kill -0 "$GPG_PID" 2>/dev/null; then
            wait "$GPG_PID"
            GPG_STATUS=$?
            OUTCOME="signed"
            break
        fi
        if ! /bin/kill -0 "$DIALOG_PID" 2>/dev/null; then
            wait "$DIALOG_PID" 2>/dev/null || true
            DIALOG_PID=""
            read_decision
            OUTCOME="dialog"
            break
        fi
        if [[ "$BUILTIN_PIN" -eq 1 ]] && ! poll_pin_entry; then
            OUTCOME="pin-window"
            break
        fi
        /bin/sleep 0.1
    done

    if [[ "$OUTCOME" == "dialog" ]]; then
        handle_operator_rejection
        case "$DECISION_VALUE" in
            sign)
                # Explicit approval; the hardware signature (and possibly the
                # PIN) may still be pending. The preview has closed, so nothing
                # else could cancel: a key that does not answer in time is
                # stopped, and the lock goes to the next request.
                gpg_waited=0
                while /bin/kill -0 "$GPG_PID" 2>/dev/null; do
                    if [[ "$BUILTIN_PIN" -eq 1 ]] && ! poll_pin_entry; then
                        OUTCOME="pin-window"
                        break
                    fi
                    if [[ "$gpg_waited" -ge $((SIGN_GPG_SECONDS * 10)) ]]; then
                        stop_gpg "$GPG_PID"
                        dismiss_pin_entry
                        release_dialog_lock
                        audit_decision "gpg-timeout" "$REPOSITORY" "$REQUEST_TYPE" "$PAYLOAD_SHA" || true
                        error "not signed: no touch or PIN before the deadline"
                        exit 70
                    fi
                    /bin/sleep 0.1
                    gpg_waited=$((gpg_waited + 1))
                done
                if [[ "$OUTCOME" != "pin-window" ]]; then
                    wait "$GPG_PID"
                    GPG_STATUS=$?
                    CHILD_PID=""
                    OUTCOME="signed"
                fi
                ;;
            *)
                stop_gpg "$GPG_PID"
                release_dialog_lock
                audit_decision "invalid-ui-decision" "$REPOSITORY" "$REQUEST_TYPE" "$PAYLOAD_SHA" || true
                error "preview returned no valid decision; refusing to sign"
                exit 70
                ;;
        esac
    fi

    if [[ "$OUTCOME" == "pin-window" && -n "$UNANSWERABLE_PROMPT" ]]; then
        stop_gpg "$GPG_PID"
        release_dialog_lock
        audit_decision "unanswerable-gpg-prompt" "$REPOSITORY" "$REQUEST_TYPE" "$PAYLOAD_SHA" || true
        error "GPG asked a question the PIN window cannot answer ($UNANSWERABLE_PROMPT); refusing to sign"
        error "check that the security key is inserted, or set pin_prompt=pinentry in $CONFIG_FILE"
        exit 70
    fi
    if [[ "$OUTCOME" == "pin-window" ]]; then
        if [[ "$(/bin/cat "$PIN_RESULT" 2>/dev/null)" == cancel ]]; then
            # Same as Cancel in the preview: GPG is stopped before signing.
            DECISION_VALUE=cancel
            handle_operator_rejection
        fi
        stop_gpg "$GPG_PID"
        release_dialog_lock
        audit_decision "invalid-ui-decision" "$REPOSITORY" "$REQUEST_TYPE" "$PAYLOAD_SHA" || true
        error "PIN window closed without an answer; refusing to sign"
        exit 70
    fi

    # Signing completed (GPG finished on its own, or after explicit approval).
    # A rejection already in flight has to land before its writer is terminated.
    await_pending_decision
    # Dismiss the review window if it is still open.
    if [[ -n "$DIALOG_PID" ]] && /bin/kill -0 "$DIALOG_PID" 2>/dev/null; then
        /bin/kill -s TERM "$DIALOG_PID" 2>/dev/null || true
        wait "$DIALOG_PID" 2>/dev/null || true
    fi
    DIALOG_PID=""
    dismiss_pin_entry
    CHILD_PID=""
    read_decision
    handle_operator_rejection
    if [[ -e "$DECIDING" ]]; then
        # The operator answered and the answer never arrived. A signature
        # exists, but not one anybody approved: never release it on an
        # unreadable outcome.
        release_dialog_lock
        audit_decision "pending-decision-lost" "$REPOSITORY" "$REQUEST_TYPE" "$PAYLOAD_SHA" || true
        error "preview began a decision that never completed; refusing to sign"
        exit 70
    fi

    if [[ "$GPG_STATUS" -ne 0 ]] && bad_pin_failure && offer_pin_retry; then
        # Drop the failed attempt's output; Git sees only the final attempt.
        GPG_STDERR=""
        ATTEMPT=$((ATTEMPT + 1))
        continue
    fi
    break
done
release_dialog_lock
flush_gpg_stderr
/bin/cat "$GPG_STDOUT"

if [[ "$GPG_STATUS" -eq 0 ]]; then
    audit_decision "sign" "$REPOSITORY" "$REQUEST_TYPE" "$PAYLOAD_SHA" || true
else
    audit_decision "gpg-error" "$REPOSITORY" "$REQUEST_TYPE" "$PAYLOAD_SHA" || true
fi

if [[ "$GPG_STATUS" -ge 129 && "$GPG_STATUS" -le 192 ]]; then
    GPG_SIGNAL=$((GPG_STATUS - 128))
    if /bin/kill -l "$GPG_SIGNAL" >/dev/null 2>&1; then
        cleanup
        trap - "$GPG_SIGNAL"
        /bin/kill -s "$GPG_SIGNAL" "$$"
    fi
fi
exit "$GPG_STATUS"
