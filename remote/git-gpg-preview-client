#!/bin/sh
# Git's gpg.openpgp.program on a host without a key: signing goes to the
# operator's machine over the tailnet, everything else to the local gpg.
self=$0
while [ -L "$self" ]; do
    dir=$(cd -P -- "$(dirname -- "$self")" && pwd)
    self=$(readlink -- "$self")
    case $self in /*) ;; *) self="$dir/$self" ;; esac
done
exec python3 "$(cd -P -- "$(dirname -- "$self")" && pwd)/git_gpg_preview_remote.py" client -- "$@"
