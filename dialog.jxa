ObjC.import('Cocoa');

function unwrap(value) {
    return ObjC.unwrap(value);
}

function readText(path) {
    const data = $.NSData.dataWithContentsOfFile(path);
    if (!data) {
        throw new Error('Unable to read review data.');
    }
    let text = $.NSString.alloc.initWithDataEncoding(data, $.NSUTF8StringEncoding);
    if (!text) {
        text = $.NSString.alloc.initWithDataEncoding(data, $.NSISOLatin1StringEncoding);
    }
    if (!text) {
        throw new Error('Unable to decode review data.');
    }
    return unwrap(text);
}

function writeDecision(path, decision) {
    const handle = $.NSFileHandle.fileHandleForWritingAtPath(path);
    if (!handle) {
        throw new Error('Unable to open the decision file.');
    }
    handle.truncateFileAtOffset(0);
    const data = $.NSString.stringWithString(decision).dataUsingEncoding($.NSUTF8StringEncoding);
    handle.writeData(data);
    handle.synchronizeFile;
    handle.closeFile;
}

// A rejection is recorded in two steps: this marker, then the decision. The
// signer terminates this process the moment GPG exits, which can land between
// the two, so the marker is what tells it an answer is still in flight and must
// be waited for rather than read as "the operator never answered".
function markDeciding(path) {
    $.NSData.data.writeToFileAtomically(path + '.deciding', true);
}

function rejectSignature(path, decision) {
    markDeciding(path);
    writeDecision(path, decision);
}

function markReady(path) {
    if (!path) return;
    $.NSData.data.writeToFileAtomically(path, true);
}

// Options: wrap breaks long lines at the pane's width instead of scrolling
// sideways; fontSize defaults to 12.
function scrollableText(text, width, height, options) {
    const wrap = !!(options && options.wrap);
    const fontSize = (options && options.fontSize) || 12;
    const frame = $.NSMakeRect(0, 0, width, height);
    const scroll = $.NSScrollView.alloc.initWithFrame(frame);
    scroll.hasVerticalScroller = true;
    scroll.hasHorizontalScroller = !wrap;
    scroll.autohidesScrollers = true;
    scroll.borderType = $.NSBezelBorder;

    const contentSize = scroll.contentSize;
    const textView = $.NSTextView.alloc.initWithFrame($.NSMakeRect(0, 0, contentSize.width, contentSize.height));
    textView.minSize = $.NSMakeSize(0, contentSize.height);
    textView.maxSize = $.NSMakeSize(10000000, 10000000);
    textView.verticallyResizable = true;
    textView.horizontallyResizable = !wrap;
    textView.autoresizingMask = $.NSViewWidthSizable;
    textView.textContainer.containerSize = $.NSMakeSize(wrap ? contentSize.width : 10000000, 10000000);
    textView.textContainer.widthTracksTextView = wrap;
    textView.editable = false;
    textView.selectable = true;
    textView.richText = false;
    textView.font = $.NSFont.monospacedSystemFontOfSizeWeight(fontSize, $.NSFontWeightRegular);
    textView.string = text;
    scroll.documentView = textView;
    return scroll;
}

// The signer writes every fact about a request on one line, then this marker,
// then the message. The first marker therefore ends the facts: nothing in a
// message can pass itself off as one of them.
const MESSAGE_MARKER = '\n\nMessage:\n';

function splitSummary(summary) {
    const at = summary.indexOf(MESSAGE_MARKER);
    if (at < 0) return {facts: '', message: summary};
    return {facts: summary.slice(0, at), message: summary.slice(at + MESSAGE_MARKER.length)};
}

const PREVIEW_WIDTH = 560;
const MESSAGE_PANE_HEIGHT = 240;
// The facts pane has room for each of its lines, so none is cut off: at 11
// points a line takes about 13, and 14 leaves a margin. It never wraps, so a
// long fact cannot pose as two; past the maximum it scrolls. Tests read these
// lines; keep the format.
const FACTS_LINE_HEIGHT = 14;
const FACTS_MIN_LINES = 8;
const FACTS_MAX_LINES = 12;
// A fact wider than this many columns of the 11-point font scrolls sideways,
// and a legacy horizontal scroll bar then takes this much of the pane's height.
const FACTS_COLUMNS = 80;
const FACTS_SCROLLER_HEIGHT = 16;
const PANE_GAP = 8;

// Room for the facts' lines, kept between the minimum and the maximum, plus
// the border, plus a horizontal scroll bar when a fact is wider than the pane.
// Characters outside ASCII count twice: a fallback font may draw them wide.
function factsPaneHeight(facts) {
    const rows = facts.split('\n');
    const lines = Math.min(Math.max(rows.length, FACTS_MIN_LINES), FACTS_MAX_LINES);
    const wide = rows.some(function(row) { return row.replace(/[^\x00-\x7f]/g, '  ').length > FACTS_COLUMNS; });
    return lines * FACTS_LINE_HEIGHT + 4 + (wide ? FACTS_SCROLLER_HEIGHT : 0);
}

// The message is what the reader came to check, so it comes first, gets the
// most room and wraps. The facts have a pane of their own, because a long
// message must not be able to scroll them out of sight.
function previewPanes(summary) {
    const parts = splitSummary(summary);
    const factsHeight = factsPaneHeight(parts.facts);
    const total = MESSAGE_PANE_HEIGHT + PANE_GAP + factsHeight;
    if (!parts.facts) return scrollableText(parts.message, PREVIEW_WIDTH, total, {wrap: true});
    const panes = $.NSView.alloc.initWithFrame($.NSMakeRect(0, 0, PREVIEW_WIDTH, total));
    const message = scrollableText(parts.message.trim() ? parts.message : '(no message)',
                                   PREVIEW_WIDTH, MESSAGE_PANE_HEIGHT, {wrap: true, fontSize: 13});
    message.frame = $.NSMakeRect(0, factsHeight + PANE_GAP, PREVIEW_WIDTH, MESSAGE_PANE_HEIGHT);
    const facts = scrollableText(parts.facts, PREVIEW_WIDTH, factsHeight, {fontSize: 11});
    panes.addSubview(message);
    panes.addSubview(facts);
    return panes;
}

// Wording for the wrong-PIN dialog. `remaining` is the card's PIN retry
// counter as a decimal string, or 'unknown' when it could not be read.
function pinErrorText(remaining, allowRetry, uncounted) {
    const known = /^[0-9]+$/.test(remaining);
    const count = known ? Number(remaining) : -1;
    if (count === 0) {
        return {
            title: 'PIN blocked',
            info: 'Your security key rejected the PIN and has no attempts left, so its PIN is now blocked. ' +
                'Signing was cancelled. To unblock it with your Admin PIN, run `gpg --card-edit`, then ' +
                '`admin`, `passwd` and option 2. With a Reset Code, run `gpg --card-edit`, then `unblock`.',
            canRetry: false
        };
    }
    // GnuPG rejects a PIN that is too short before it reaches the key, so a
    // wrong PIN does not always use up an attempt.
    let info = uncounted
        ? 'The PIN was rejected before it reached your security key, so no attempt was used (PINs are at least 6 characters). '
        : 'Your security key did not accept the PIN. ';
    if (count === 1) {
        info += '1 attempt remaining. One more wrong PIN blocks the key\'s PIN until it is unblocked with the Admin PIN.';
    } else if (known) {
        info += count + ' attempts remaining before the key blocks its PIN.';
    } else {
        info += 'The number of remaining attempts could not be read from the key (most keys block the PIN after 3 wrong attempts).';
    }
    if (allowRetry) {
        info += '\n\nTry Again opens a new, empty PIN prompt. Cancel aborts this signature.';
    } else {
        info += '\n\nSigning was cancelled.';
    }
    return {title: 'Incorrect PIN', info: info, canRetry: allowRetry};
}

// Shown by the signer after GPG fails with a wrong PIN. Writes 'retry' only
// when the user explicitly picks Try Again; anything else is 'cancel'.
function runPinError(argv) {
    if (argv.length < 1) {
        throw new Error('Expected a decision path.');
    }
    const decisionPath = argv[0];
    const remaining = argv.length > 1 ? String(argv[1]) : 'unknown';
    const text = pinErrorText(remaining, argv.length > 2 && argv[2] === 'retry',
                              argv.length > 3 && argv[3] === 'uncounted');

    const pinApp = $.NSApplication.sharedApplication;
    pinApp.setActivationPolicy($.NSApplicationActivationPolicyAccessory);
    pinApp.activateIgnoringOtherApps(true);

    const pinAlert = $.NSAlert.alloc.init;
    pinAlert.alertStyle = $.NSAlertStyleCritical;
    pinAlert.messageText = text.title;
    pinAlert.informativeText = text.info;
    if (text.canRetry) {
        pinAlert.addButtonWithTitle('Try Again');
        pinAlert.addButtonWithTitle('Cancel');
    } else {
        pinAlert.addButtonWithTitle('OK');
    }
    const response = Number(pinAlert.runModal);
    const retry = text.canRetry && response === Number($.NSAlertFirstButtonReturn);
    writeDecision(decisionPath, retry ? 'retry' : 'cancel');
}

// OpenPGP cards need at least 6 bytes for the user PIN; scdaemon rejects
// shorter ones without asking the key, which would look like a wrong PIN.
const MIN_PIN_BYTES = 6;

// The line under the PIN field. Two or fewer attempts left is a warning.
function remainingAttemptsLabel(remaining) {
    if (!/^[0-9]+$/.test(remaining)) {
        return {text: 'Attempts remaining: unknown', warn: false};
    }
    const count = Number(remaining);
    if (count === 0) return {text: 'PIN blocked: no attempts remaining', warn: true};
    return {text: count + (count === 1 ? ' attempt remaining' : ' attempts remaining'), warn: count <= 2};
}

function pinEntryView(labelText, warn) {
    const view = $.NSView.alloc.initWithFrame($.NSMakeRect(0, 0, 320, 64));
    const field = $.NSSecureTextField.alloc.initWithFrame($.NSMakeRect(0, 38, 320, 24));
    field.placeholderString = 'PIN';
    const label = $.NSTextField.wrappingLabelWithString(labelText);
    label.frame = $.NSMakeRect(0, 0, 320, 32);
    if (warn) {
        label.font = $.NSFont.boldSystemFontOfSize(13);
        label.textColor = $.NSColor.systemRedColor;
    } else {
        label.font = $.NSFont.systemFontOfSize(12);
        label.textColor = $.NSColor.secondaryLabelColor;
    }
    view.addSubview(field);
    view.addSubview(label);
    return {view: view, field: field, label: label};
}

// The PIN goes straight into the pipe GPG reads; it is never written to a file.
function sendPin(channelPath, pin) {
    const handle = $.NSFileHandle.fileHandleForWritingAtPath(channelPath);
    if (!handle) {
        throw new Error('Unable to open the PIN channel.');
    }
    handle.writeData($.NSString.stringWithString(pin + '\n').dataUsingEncoding($.NSUTF8StringEncoding));
    handle.closeFile;
}

// Shown by the signer when GPG asks for the card PIN. Writes 'entered' after
// sending the PIN, or 'cancel'. Every prompt starts with an empty field.
function runPinEntry(argv) {
    if (argv.length < 2) {
        throw new Error('Expected PIN channel and result paths.');
    }
    const channelPath = argv[0];
    const resultPath = argv[1];
    const remaining = argv.length > 2 ? String(argv[2]) : 'unknown';
    const attempt = argv.length > 3 ? (Number(argv[3]) || 1) : 1;
    const status = remainingAttemptsLabel(remaining);

    const pinEntryApp = $.NSApplication.sharedApplication;
    pinEntryApp.setActivationPolicy($.NSApplicationActivationPolicyAccessory);
    pinEntryApp.activateIgnoringOtherApps(true);

    let problem = '';
    while (true) {
        const pinEntryAlert = $.NSAlert.alloc.init;
        pinEntryAlert.alertStyle = $.NSAlertStyleInformational;
        pinEntryAlert.messageText = attempt > 1 ? 'Enter your security key PIN again' : 'Enter your security key PIN';
        pinEntryAlert.informativeText = (attempt > 1 ? 'The previous PIN was incorrect. ' : '') +
            'Git is asking your key to sign the request in the review window. Enter the PIN, then touch the key when it blinks.';
        const parts = problem
            ? pinEntryView(problem + ' ' + status.text + '.', true)
            : pinEntryView(status.text, status.warn);
        pinEntryAlert.accessoryView = parts.view;
        pinEntryAlert.addButtonWithTitle('OK');
        pinEntryAlert.addButtonWithTitle('Cancel');
        pinEntryAlert.window.initialFirstResponder = parts.field;
        const response = Number(pinEntryAlert.runModal);
        if (response !== Number($.NSAlertFirstButtonReturn)) {
            writeDecision(resultPath, 'cancel');
            return;
        }
        const pin = ObjC.unwrap(parts.field.stringValue).replace(/[\r\n]/g, '');
        const bytes = Number($.NSString.stringWithString(pin).lengthOfBytesUsingEncoding($.NSUTF8StringEncoding));
        if (bytes < MIN_PIN_BYTES) {
            problem = 'PINs have at least ' + MIN_PIN_BYTES + ' characters; nothing was sent to your key.';
            continue;
        }
        sendPin(channelPath, pin);
        writeDecision(resultPath, 'entered');
        return;
    }
}

function run(argv) {
    // A signing service from before the cached touch policy offer was removed
    // asks for its window this way. Refuse it plainly instead of reading the
    // flag as a summary path; that service then signs on without the offer.
    if (argv.length > 0 && (argv[0] === '--touch-offer' || argv[0] === '--touch-unchanged')) {
        throw new Error('The cached touch policy offer was removed. Restart the signing service ' +
                        '(git-gpg-preview-setup serve-install) so it runs the version installed with this dialog.');
    }
    if (argv.length > 0 && argv[0] === '--pin-error') {
        runPinError(argv.slice(1));
        return;
    }
    if (argv.length > 0 && argv[0] === '--pin-entry') {
        runPinEntry(argv.slice(1));
        return;
    }
    if (argv.length < 3) {
        throw new Error('Expected summary, details, and decision paths.');
    }
    const summary = readText(argv[0]);
    const details = readText(argv[1]);
    const decisionPath = argv[2];
    const readyPath = argv.length > 3 ? argv[3] : '';
    // Explicit capabilities from the signer; never infer them from payload text.
    const canMarkSpam = argv.length > 4 && argv[4] === 'mark-spam';
    // With touch policy off, or one the signer could not read, the key may sign
    // without a touch, so the signer starts GPG only after Sign here; the notice
    // comes with the request.
    const requireSign = argv.length > 5 && argv[5] === 'require-sign';
    const signNotice = argv.length > 6 ? String(argv[6]) : '';

    const app = $.NSApplication.sharedApplication;
    app.setActivationPolicy($.NSApplicationActivationPolicyAccessory);
    // Activate once, up front, before GPG (and therefore pinentry) is engaged.
    // We deliberately do not re-activate afterward: the PIN prompt launches
    // last and must stay frontmost and focused, not behind this preview.
    app.activateIgnoringOtherApps(true);

    let first = true;
    while (true) {
        const alert = $.NSAlert.alloc.init;
        alert.alertStyle = $.NSAlertStyleInformational;
        alert.messageText = 'Confirm signature on your key';
        alert.informativeText = requireSign
            ? signNotice + '\n\nYour key may sign without a touch, so nothing is signed until you click Sign. ' +
              'View Details for the full payload, or Cancel to abort.'
            : 'Touch your key to sign; this closes when done. View Details for the full payload, or Cancel to abort.';
        alert.accessoryView = previewPanes(summary);
        alert.addButtonWithTitle('View Details');
        alert.addButtonWithTitle('Cancel');
        if (canMarkSpam) alert.addButtonWithTitle('Mark as Spam');
        // Last, so Return (View Details) never signs by accident.
        if (requireSign) alert.addButtonWithTitle('Sign');
        // Report readiness only once, as the first preview is about to show,
        // so the wrapper engages GPG after this window is already up.
        if (first) {
            markReady(readyPath);
            first = false;
        }
        const response = Number(alert.runModal);
        if (response === Number($.NSAlertSecondButtonReturn)) {
            rejectSignature(decisionPath, 'cancel');
            return;
        }
        if (canMarkSpam && response === Number($.NSAlertThirdButtonReturn)) {
            rejectSignature(decisionPath, 'spam');
            return;
        }
        if (requireSign && response === Number($.NSAlertThirdButtonReturn) + (canMarkSpam ? 1 : 0)) {
            writeDecision(decisionPath, 'sign');
            return;
        }

        const detailAlert = $.NSAlert.alloc.init;
        detailAlert.alertStyle = $.NSAlertStyleInformational;
        detailAlert.messageText = 'Exact Payload and Derived Review Report';
        detailAlert.informativeText = 'The exact GPG input is explicitly marked between the payload markers. The full diff is derived from Git objects and is not literal signed input. ' +
            (requireSign ? 'Return and click Sign to sign, or Cancel to abort.' : 'Touch your security key to sign, or return and Cancel to abort.');
        detailAlert.accessoryView = scrollableText(details, 920, 600);
        detailAlert.addButtonWithTitle('Back');
        detailAlert.addButtonWithTitle('Cancel');
        if (canMarkSpam) detailAlert.addButtonWithTitle('Mark as Spam');
        const detailResponse = Number(detailAlert.runModal);
        if (detailResponse === Number($.NSAlertSecondButtonReturn)) {
            rejectSignature(decisionPath, 'cancel');
            return;
        }
        if (canMarkSpam && detailResponse === Number($.NSAlertThirdButtonReturn)) {
            rejectSignature(decisionPath, 'spam');
            return;
        }
    }
}
