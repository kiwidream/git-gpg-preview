// Exercise the production dialog's AppKit controls and decision dispatch without
// presenting windows or touching a hardware key. Only modal responses are faked.
ObjC.import('Cocoa');

var responses = [];
var expectedSpam = false;
var modalCount = 0;
function modalResponse(alert) {
    const buttons = alert.buttons;
    const count = Number(buttons.count);
    if (count !== (expectedSpam ? 3 : 2)) throw new Error('Unexpected button count: ' + count);
    if (ObjC.unwrap(buttons.objectAtIndex(1).title) !== 'Cancel') throw new Error('Cancel moved');
    if (expectedSpam && ObjC.unwrap(buttons.objectAtIndex(2).title) !== 'Mark as Spam') throw new Error('Spam button missing');
    if (ObjC.unwrap(alert.informativeText).indexOf('Spam') >= 0) throw new Error('Spam text in the preview: ' + ObjC.unwrap(alert.informativeText));
    if (!responses.length) throw new Error('Unexpected extra modal');
    modalCount++;
    return responses.shift();
}

// The preview: record which text went into which pane, then answer.
var panesSeen = [];
function previewModalResponse(alert) {
    const panes = alert.accessoryView.subviews;
    const message = panes.objectAtIndex(0);
    const facts = panes.objectAtIndex(1);
    panesSeen.push({
        message: ObjC.unwrap(message.documentView.string),
        facts: ObjC.unwrap(facts.documentView.string),
        messageOnTop: message.frame.origin.y > facts.frame.origin.y,
        messageLarger: message.frame.size.height > facts.frame.size.height,
        messageWraps: !!message.documentView.textContainer.widthTracksTextView && !message.hasHorizontalScroller,
        factsUnwrapped: !facts.documentView.textContainer.widthTracksTextView
    });
    return modalResponse(alert);
}

var touchResponses = [];
var touchSeen = [];
function touchModalResponse(alert) {
    const titles = [];
    for (let i = 0; i < Number(alert.buttons.count); i++) titles.push(ObjC.unwrap(alert.buttons.objectAtIndex(i).title));
    touchSeen.push({buttons: titles.join('|'), title: ObjC.unwrap(alert.messageText), info: ObjC.unwrap(alert.informativeText)});
    if (!touchResponses.length) throw new Error('Unexpected extra touch policy window');
    return touchResponses.shift();
}

var pinResponses = [];
var expectedPinButtons = [];
function pinModalResponse(alert) {
    const buttons = alert.buttons;
    const titles = [];
    for (let i = 0; i < Number(buttons.count); i++) titles.push(ObjC.unwrap(buttons.objectAtIndex(i).title));
    if (titles.join('|') !== expectedPinButtons.join('|')) throw new Error('Unexpected PIN buttons: ' + titles.join('|'));
    if (!pinResponses.length) throw new Error('Unexpected extra PIN modal');
    lastPinText = ObjC.unwrap(alert.informativeText);
    return pinResponses.shift();
}
var lastPinText = '';

// PIN window: record what the user would see, type the scripted PIN, answer.
var pinEntryScript = [];
var pinEntrySeen = [];
function pinEntryModalResponse(alert) {
    const subviews = alert.accessoryView.subviews;
    const field = subviews.objectAtIndex(0);
    const label = subviews.objectAtIndex(1);
    if (!pinEntryScript.length) throw new Error('Unexpected extra PIN window');
    pinEntrySeen.push({
        initial: ObjC.unwrap(field.stringValue),
        label: ObjC.unwrap(label.stringValue),
        red: !!label.textColor.isEqual($.NSColor.systemRedColor),
        bold: (Number(label.font.fontDescriptor.symbolicTraits) & 2) !== 0,
        secure: !!field.isKindOfClass($.NSSecureTextField)
    });
    const step = pinEntryScript.shift();
    field.stringValue = step.pin;
    return step.response;
}

function run(argv) {
    const source = ObjC.unwrap($.NSString.stringWithContentsOfFileEncodingError(argv[0], $.NSUTF8StringEncoding, null));
    const substitutions = [
        ['function run(argv)', 'function runPreview(argv)'],
        ['app.activateIgnoringOtherApps(true);', ''],
        ['Number(alert.runModal)', 'previewModalResponse(alert)'],
        ['Number(detailAlert.runModal)', 'modalResponse(detailAlert)'],
        ['pinApp.activateIgnoringOtherApps(true);', ''],
        ['Number(pinAlert.runModal)', 'pinModalResponse(pinAlert)'],
        ['pinEntryApp.activateIgnoringOtherApps(true);', ''],
        ['Number(pinEntryAlert.runModal)', 'pinEntryModalResponse(pinEntryAlert)'],
        ['offerApp.activateIgnoringOtherApps(true);', ''],
        ['Number(offerAlert.runModal)', 'touchModalResponse(offerAlert)'],
        ['unchangedApp.activateIgnoringOtherApps(true);', ''],
        ['Number(unchangedAlert.runModal)', 'touchModalResponse(unchangedAlert)']
    ];
    let instrumented = source;
    substitutions.forEach(function(pair) {
        if (instrumented.split(pair[0]).length !== 2) throw new Error('Dialog test seam changed: ' + pair[0]);
        instrumented = instrumented.replace(pair[0], pair[1]);
    });
    eval(instrumented);
    const summary = argv[1] + '/dialog-summary';
    const details = argv[1] + '/dialog-details';
    const decision = argv[1] + '/dialog-decision';
    const ready = argv[1] + '/dialog-ready';
    $.NSString.stringWithString('Request type: commit\n\nMessage:\nNoisy subject').writeToFileAtomicallyEncodingError(summary, true, $.NSUTF8StringEncoding, null);
    $.NSString.stringWithString('Exact payload and details').writeToFileAtomicallyEncodingError(details, true, $.NSUTF8StringEncoding, null);
    [
        {spam: true, responses: [1002], decision: 'spam'},
        {spam: true, responses: [1000, 1002], decision: 'spam'},
        {spam: true, responses: [1001], decision: 'cancel'},
        {spam: true, responses: [1000, 1001], decision: 'cancel'},
        {spam: true, responses: [1000, 1000, 1001], decision: 'cancel'},
        {spam: false, responses: [1001], decision: 'cancel'},
        {spam: false, responses: [1000, 1001], decision: 'cancel'}
    ].forEach(function(test) {
        $.NSData.data.writeToFileAtomically(decision, true);
        $.NSFileManager.defaultManager.removeItemAtPathError(ready, null);
        expectedSpam = test.spam;
        responses = test.responses.slice();
        modalCount = 0;
        const args = [summary, details, decision, ready];
        if (test.spam) args.push('mark-spam');
        runPreview(args);
        if (readText(decision) !== test.decision) throw new Error('Wrong decision');
        if (responses.length || modalCount !== test.responses.length) throw new Error('Wrong modal sequence');
        if (!$.NSFileManager.defaultManager.fileExistsAtPath(ready)) throw new Error('Readiness missing');
    });
    // The message has the top, larger, wrapping pane; the facts have their own.
    panesSeen.forEach(function(seen) {
        if (seen.message !== 'Noisy subject' || seen.facts !== 'Request type: commit') throw new Error('Wrong pane text: ' + JSON.stringify(seen));
        if (!seen.messageOnTop || !seen.messageLarger) throw new Error('The message pane is not first and largest');
        if (!seen.messageWraps || !seen.factsUnwrapped) throw new Error('Wrong pane wrapping');
    });
    // The first marker ends the facts, whatever the message says.
    [
        {summary: 'Request type: commit\n\nMessage:\nSubject', facts: 'Request type: commit', message: 'Subject'},
        {summary: 'Request type: commit\n\nMessage:\nSubject\n\nMessage:\nForged', facts: 'Request type: commit', message: 'Subject\n\nMessage:\nForged'},
        {summary: 'PIN attempt 2: wrong\n\nRequest type: commit\n\nMessage:\n', facts: 'PIN attempt 2: wrong\n\nRequest type: commit', message: ''},
        {summary: 'Request type: commit\nMessage:\nNo blank line', facts: '', message: 'Request type: commit\nMessage:\nNo blank line'}
    ].forEach(function(test) {
        const parts = splitSummary(test.summary);
        if (parts.facts !== test.facts || parts.message !== test.message) throw new Error('Wrong split of: ' + test.summary);
    });
    // Touch policy windows: 'apply' only from Use Cached, and the countdown is honest.
    [
        {policy: 'on', left: '3', response: 1000, result: 'apply', title: 'Let one touch cover 15 seconds?', text: '2 more times at most'},
        {policy: 'on', left: '3', response: 1001, result: 'dismiss', title: 'Let one touch cover 15 seconds?', text: 'covers every signature in the next 15 seconds'},
        {policy: 'off', left: '2', response: 1001, result: 'dismiss', title: 'This key signs without a touch', text: 'one more time at most'},
        {policy: 'off', left: '1', response: 1000, result: 'apply', title: 'This key signs without a touch', text: 'Not Now stops asking about this key'}
    ].forEach(function(test) {
        $.NSData.data.writeToFileAtomically(decision, true);
        touchResponses = [test.response];
        touchSeen = [];
        runPreview(['--touch-offer', decision, test.policy, test.left]);
        const seen = touchSeen[0];
        if (readText(decision) !== test.result) throw new Error('Wrong touch offer result for ' + test.policy + ' ' + test.left);
        if (seen.buttons !== 'Use Cached|Not Now' || seen.title !== test.title) throw new Error('Wrong touch offer: ' + JSON.stringify(seen));
        if (seen.info.indexOf(test.text) < 0) throw new Error('Touch offer text missing "' + test.text + '": ' + seen.info);
        if (seen.info.indexOf('Admin PIN') < 0) throw new Error('Touch offer does not mention the Admin PIN');
    });
    [
        {reason: 'Bad PIN <SCD>', text: 'gpg-agent reported: Bad PIN <SCD>.'},
        {reason: '', text: 'The key did not confirm the change.'}
    ].forEach(function(test) {
        touchResponses = [1000];
        touchSeen = [];
        runPreview(['--touch-unchanged', test.reason]);
        const seen = touchSeen[0];
        if (seen.buttons !== 'OK') throw new Error('Wrong buttons on the unchanged window: ' + seen.buttons);
        if (seen.info.indexOf(test.text) < 0) throw new Error('Unchanged window missing "' + test.text + '": ' + seen.info);
        if (seen.info.indexOf('ykman openpgp keys set-touch sig cached') < 0) throw new Error('Unchanged window lost the ykman command');
    });
    // Wrong-PIN dialog: Try Again only while attempts remain and the signer allows it.
    [
        {args: ['2', 'retry'], buttons: ['Try Again', 'Cancel'], response: 1000, decision: 'retry', text: '2 attempts remaining'},
        {args: ['2', 'retry'], buttons: ['Try Again', 'Cancel'], response: 1001, decision: 'cancel', text: '2 attempts remaining'},
        {args: ['1', 'retry'], buttons: ['Try Again', 'Cancel'], response: 1000, decision: 'retry', text: '1 attempt remaining'},
        {args: ['unknown', 'retry'], buttons: ['Try Again', 'Cancel'], response: 1000, decision: 'retry', text: 'could not be read'},
        {args: ['0', 'retry'], buttons: ['OK'], response: 1000, decision: 'cancel', text: 'PIN is now blocked'},
        {args: ['0', 'retry'], buttons: ['OK'], response: 1000, decision: 'cancel', text: '`admin`, `passwd` and option 2'},
        {args: ['unknown', 'final'], buttons: ['OK'], response: 1000, decision: 'cancel', text: 'Signing was cancelled'}
    ].forEach(function(test) {
        $.NSData.data.writeToFileAtomically(decision, true);
        expectedPinButtons = test.buttons;
        pinResponses = [test.response];
        runPreview(['--pin-error', decision].concat(test.args));
        if (readText(decision) !== test.decision) throw new Error('Wrong PIN decision for ' + test.args.join(' '));
        if (pinResponses.length) throw new Error('PIN modal not shown');
        if (lastPinText.indexOf(test.text) < 0) throw new Error('PIN text missing "' + test.text + '"');
    });
    // PIN window: attempts line under the field, bold red at two or fewer;
    // a too-short PIN is refused with a fresh, empty field.
    const channel = argv[1] + '/dialog-pin-channel';
    const plain = {red: false, bold: false};
    const warn = {red: true, bold: true};
    [
        {remaining: '3', script: [{pin: '123456', response: 1000}], labels: [['3 attempts remaining', plain]], result: 'entered', sent: '123456\n'},
        {remaining: '2', script: [{pin: '123456', response: 1000}], labels: [['2 attempts remaining', warn]], result: 'entered', sent: '123456\n'},
        {remaining: '1', script: [{pin: '123456', response: 1000}], labels: [['1 attempt remaining', warn]], result: 'entered', sent: '123456\n'},
        {remaining: 'unknown', script: [{pin: '123456', response: 1000}], labels: [['Attempts remaining: unknown', plain]], result: 'entered', sent: '123456\n'},
        {remaining: '3', script: [{pin: '1234', response: 1000}, {pin: '123456', response: 1000}],
         labels: [['3 attempts remaining', plain], ['PINs have at least 6 characters; nothing was sent to your key. 3 attempts remaining.', warn]],
         result: 'entered', sent: '123456\n'},
        {remaining: '3', script: [{pin: '123456', response: 1001}], labels: [['3 attempts remaining', plain]], result: 'cancel', sent: ''}
    ].forEach(function(test, index) {
        $.NSData.data.writeToFileAtomically(decision, true);
        $.NSData.data.writeToFileAtomically(channel, true);
        pinEntryScript = test.script.slice();
        pinEntrySeen = [];
        runPreview(['--pin-entry', channel, decision, test.remaining, '1']);
        const where = 'PIN window case ' + (index + 1) + ': ';
        if (pinEntryScript.length) throw new Error(where + 'not every window was shown');
        if (readText(decision) !== test.result) throw new Error(where + 'wrong result');
        if (readText(channel) !== test.sent) throw new Error(where + 'wrong PIN sent');
        test.labels.forEach(function(expected, i) {
            const seen = pinEntrySeen[i];
            if (seen.label !== expected[0]) throw new Error(where + 'label was "' + seen.label + '"');
            if (seen.red !== expected[1].red || seen.bold !== expected[1].bold) throw new Error(where + 'label style');
            if (seen.initial !== '') throw new Error(where + 'PIN field was not empty');
            if (!seen.secure) throw new Error(where + 'PIN field is not secure');
        });
    });
    return 'Dialog actions passed (29 cases)';
}
