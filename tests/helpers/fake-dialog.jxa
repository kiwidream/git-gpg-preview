ObjC.import('Foundation');

function append(path, text) {
    const manager = $.NSFileManager.defaultManager;
    if (!manager.fileExistsAtPath(path)) {
        $.NSData.data.writeToFileAtomically(path, true);
    }
    const handle = $.NSFileHandle.fileHandleForWritingAtPath(path);
    handle.seekToEndOfFile;
    handle.writeData($.NSString.stringWithString(text).dataUsingEncoding($.NSUTF8StringEncoding));
    handle.closeFile;
}

function write(path, text) {
    const handle = $.NSFileHandle.fileHandleForWritingAtPath(path);
    handle.truncateFileAtOffset(0);
    handle.writeData($.NSString.stringWithString(text).dataUsingEncoding($.NSUTF8StringEncoding));
    handle.closeFile;
}

function markDeciding(path) {
    $.NSData.data.writeToFileAtomically(path + '.deciding', true);
}

function readText(path) {
    const data = $.NSData.dataWithContentsOfFile(path);
    if (!data) return '';
    return ObjC.unwrap($.NSString.alloc.initWithDataEncoding(data, $.NSUTF8StringEncoding)) || '';
}

function run(argv) {
    const env = $.NSProcessInfo.processInfo.environment;
    const log = ObjC.unwrap(env.objectForKey('FAKE_DIALOG_LOG') || '');
    const captureDir = ObjC.unwrap(env.objectForKey('FAKE_DIALOG_CAPTURE_DIR') || '');
    let decision = ObjC.unwrap(env.objectForKey('FAKE_DIALOG_DECISION') || 'sign');
    const delay = Number(ObjC.unwrap(env.objectForKey('FAKE_DIALOG_DELAY') || '0'));
    const touch = ObjC.unwrap(env.objectForKey('FAKE_TOUCH_FILE') || '');
    if (argv[0] === '--pin-entry') {
        // Type the next PIN from FAKE_PIN_ENTRIES (comma-separated); CANCEL
        // presses Cancel. argv: channel, result, remaining, attempt.
        if (log) append(log, 'pin-entry ' + argv[3] + ' ' + argv[4] + '\n');
        const entries = ObjC.unwrap(env.objectForKey('FAKE_PIN_ENTRIES') || '').split(',');
        const used = ObjC.unwrap(env.objectForKey('FAKE_PIN_ENTRY_STATE') || '');
        const index = used ? readText(used).split('\n').filter(Boolean).length : 0;
        if (used) append(used, 'x\n');
        const pin = entries[index] || 'CANCEL';
        if (pin === 'CANCEL') {
            write(argv[2], 'cancel');
            return;
        }
        // "a+b" sends two lines, like a PIN that lands as its attempt ends.
        const handle = $.NSFileHandle.fileHandleForWritingAtPath(argv[1]);
        handle.writeData($.NSString.stringWithString(pin.split('+').join('\n') + '\n').dataUsingEncoding($.NSUTF8StringEncoding));
        handle.closeFile;
        write(argv[2], 'entered');
        return;
    }
    if (argv[0] === '--pin-error') {
        // Record what the user would be told, then answer Try Again or Cancel.
        if (log) append(log, 'pin-error ' + argv.slice(2).join(' ') + '\n');
        write(argv[1], ObjC.unwrap(env.objectForKey('FAKE_PIN_ERROR_DECISION') || 'retry'));
        return;
    }
    // FAKE_DIALOG_DECISIONS answers one preview each, in order (comma-separated,
    // counted in FAKE_DIALOG_DECISION_STATE; past its end, no answer). Besides
    // the answers below: hang never answers, '' closes without an answer,
    // raw:TEXT writes TEXT (\n and \0 escapes) with no marker, and marker-sign
    // writes the rejection marker and then sign.
    const sequence = env.objectForKey('FAKE_DIALOG_DECISIONS');
    if (sequence) {
        const state = ObjC.unwrap(env.objectForKey('FAKE_DIALOG_DECISION_STATE') || '');
        const index = state ? readText(state).split('\n').filter(Boolean).length : 0;
        if (state) append(state, 'x\n');
        decision = ObjC.unwrap(sequence).split(',')[index] || '';
    }
    const pid = String($.NSProcessInfo.processInfo.processIdentifier);
    if (log) append(log, 'start ' + pid + '\n');
    if (argv.length > 3 && argv[3]) {
        $.NSData.data.writeToFileAtomically(argv[3], true);
    }
    if (captureDir) {
        $.NSData.dataWithContentsOfFile(argv[0]).writeToFileAtomically(captureDir + '/' + pid + '.summary', true);
        $.NSData.dataWithContentsOfFile(argv[1]).writeToFileAtomically(captureDir + '/' + pid + '.details', true);
        // What the signer passed beyond the files: require-sign and the notice.
        $.NSString.stringWithString((argv[5] || '') + '\n' + (argv[6] || ''))
            .writeToFileAtomicallyEncodingError(captureDir + '/' + pid + '.gate', true, $.NSUTF8StringEncoding, null);
    }
    if (delay > 0) $.NSThread.sleepForTimeInterval(delay);
    const touchIt = function() {
        if (!touch) return;
        const match = readText(argv[0]).match(/SHA-256:\s*([0-9a-f]+)/);
        $.NSData.data.writeToFileAtomically(touch + '.' + (match ? match[1] : 'default'), true);
    };
    if (decision === 'hang') {
        $.NSThread.sleepForTimeInterval(30);
        return;
    }
    if (decision === '' || decision.indexOf('raw:') === 0 || decision === 'marker-sign') {
        if (decision.indexOf('raw:') === 0) {
            touchIt();
            write(argv[2], decision.slice(4).replace(/\\n/g, '\n').replace(/\\0/g, '\0'));
        } else if (decision === 'marker-sign') {
            touchIt();
            markDeciding(argv[2]);
            write(argv[2], 'sign');
        }
        if (log) append(log, 'end ' + pid + '\n');
        return;
    }
    // A real preview has no Sign button: the hardware touch completes signing.
    // For "sign" the fake reports that touch so the fake GPG can proceed; for
    // "cancel" it reports no touch, and the wrapper kills GPG before signing.
    // The touch file is keyed by the payload SHA-256 shown in the summary so
    // that concurrent, distinct requests stay isolated from one another.
    if ((decision === 'sign' || decision === 'touch-then-spam'
         || decision === 'touch-then-stall-spam') && touch) {
        const match = readText(argv[0]).match(/SHA-256:\s*([0-9a-f]+)/);
        const key = match ? match[1] : 'default';
        $.NSData.data.writeToFileAtomically(touch + '.' + key, true);
    }
    if (decision === 'touch-then-stall-spam') {
        // Mark as Spam pressed as the touch lands: the marker is recorded and
        // then this process is terminated before the decision itself can be.
        markDeciding(argv[2]);
        $.NSThread.sleepForTimeInterval(30);
        return;
    }
    // The real dialog marks any rejection before writing it; mirror that here.
    if (decision !== 'sign') markDeciding(argv[2]);
    write(argv[2], decision === 'touch-then-spam' ? 'spam' : decision);
    if (log) append(log, 'end ' + $.NSProcessInfo.processInfo.processIdentifier + '\n');
}
