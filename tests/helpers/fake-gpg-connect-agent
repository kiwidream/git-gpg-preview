#!/bin/bash

# Stands in for gpg-connect-agent: answers SCD GETATTR for the card in the
# reader the way scdaemon does. FAKE_CARD_SIG_KEY is the fingerprint in its
# signature slot (unset: no card) and FAKE_CARD_UIF the raw UIF-1 value as
# scdaemon escapes it, such as "%01+" for touch policy on. Until SERIALNO
# selects the OpenPGP application, another one (PIV, say) answers GETATTR.
# SCD APDU 00CA00D600 (GET DATA for DO D6) reads the card's current policy;
# SCD GETATTR UIF-1 answers from FAKE_SCD_CACHE, when set, the way scdaemon
# answers from the copy it read first. SCD KILLSCD empties FAKE_CARD_QUEUE,
# the card's pending operations, and that cache. Options (--hex, --homedir DIR)
# are skipped. FAKE_KILLSCD_SLEEP delays SCD KILLSCD (a wedged scdaemon).
# FAKE_CONNECT_AGENT_EXIT is the exit status after answering.

set -u
umask 077

printf '%s\n' "$*" >> "${FAKE_GPG_CALL_DIR:?}/connect-agent-calls"
while [[ "${1-}" == --* ]]; do
    [[ "$1" == --homedir ]] && shift
    shift
done
openpgp=0
for command in "$@"; do
    [[ "$command" == /bye ]] && break
    if [[ -z "${FAKE_CARD_SIG_KEY-}" ]]; then
        printf 'ERR 100696144 No such device <SCD>\n'
        continue
    fi
    if [[ ( "$command" == 'SCD GETATTR '* || "$command" == 'SCD APDU '* ) && "$openpgp" -eq 0 ]]; then
        printf 'ERR 100663423 Not supported <SCD>\n'
        continue
    fi
    case "$command" in
        'SCD SERIALNO openpgp')
            openpgp=1
            printf 'S SERIALNO D2760001240100000006000000010000 0\nOK\n'
            ;;
        'SCD GETATTR KEY-FPR')
            printf 'S KEY-FPR 1 %s\nS KEY-FPR 2 DDDD000000000000000000000000000000000002\nOK\n' "$FAKE_CARD_SIG_KEY"
            ;;
        'SCD GETATTR UIF-1')
            uif=${FAKE_CARD_UIF-}
            if [[ -n "${FAKE_SCD_CACHE-}" ]]; then
                [[ -s "$FAKE_SCD_CACHE" ]] || printf '%s' "$uif" > "$FAKE_SCD_CACHE"
                uif=$(cat "$FAKE_SCD_CACHE")
            fi
            if [[ -n "$uif" ]]; then
                printf 'S UIF-1 %s\nOK\n' "$uif"
            else
                printf 'ERR 100663354 No such object <SCD>\n'
            fi
            ;;
        'SCD APDU 00CA00D600')
            # As gpg-connect-agent --hex prints it: the policy byte, 0x20, 90 00.
            if [[ "${FAKE_CARD_UIF-}" =~ ^%(0[0-9A-F])\+$ ]]; then
                printf 'D[0000]  %s 20 90 00                                         . ..\nOK\n' "${BASH_REMATCH[1]}"
            else
                printf 'ERR 100663354 No such object <SCD>\n'
            fi
            ;;
        'SCD KILLSCD')
            # scdaemon stops: every operation queued at the card ends.
            [[ -z "${FAKE_KILLSCD_SLEEP-}" ]] || sleep "$FAKE_KILLSCD_SLEEP"
            [[ -z "${FAKE_CARD_QUEUE-}" ]] || : > "$FAKE_CARD_QUEUE"
            [[ -z "${FAKE_SCD_CACHE-}" ]] || : > "$FAKE_SCD_CACHE"
            printf 'OK\n'
            ;;
        *) printf 'ERR 69 Unknown IPC command <User defined source 1>\n' ;;
    esac
done
exit "${FAKE_CONNECT_AGENT_EXIT:-0}"
